project UNIFIED_CONSCIOUSNESS:
  version 11
  title "統合意識と優先順位付き記憶の方向転換"
  description "Owner direction2026-10-10; requirements docs/unified-consciousness-design-v1.md; ADR0067 revision2 as superseded in part by Accepted ADR0069 revision1 and docs/unified-consciousness-contract-v1.md C1-C8. Canonical successor planning for new consciousness work. Preserve historical awareness-v5 and unfinished release evidence. Estimates provisional. Owner authorized production deployment2026-10-10; separate bounded paid-trial authority is still required."
  duration_unit point
  finish DEPLOYED
  goal_owner user
  dag_owner agent
resource DEV:
  title "Developer"
  capacity 1
