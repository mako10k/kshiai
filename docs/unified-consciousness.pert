project UNIFIED_CONSCIOUSNESS:
  version 5
  title "統合意識と優先順位付き記憶の方向転換"
  description "Owner direction2026-10-10; requirements docs/unified-consciousness-design-v1.md; Accepted ADR0067 revision2 and docs/unified-consciousness-contract-v1.md C1-C8. Canonical successor planning for new consciousness work. Preserve historical awareness-v5 and unfinished release evidence. Estimates provisional, no measured velocity or paid/deploy authority."
  duration_unit point
  finish CURRENTLY_VERIFIED
  goal_owner user
  dag_owner agent
