# Delivery plan revision 3: replace legacy B6-B7 with accepted kernel slices 1-5.
project csm001:
  version 8
  title "Restore character authoring and migrate frozen ready V2 characters to strict V3"
  description "Execute the accepted two-lane recovery plan as refined by accepted ADR-0031. Before B6 or any focused-kernel implementation, D11 fixes and reviews typed contracts, numeric safety policy, public Q&A mapping, fenced persistence and adapter conformance. Deployment, provider generation, owner candidate acceptance, append/CAS and cutover retain separate gates."
  as_of 2026-09-10
  duration_unit point
  velocity 1p/1d
  finish cm114

resource cr001:
  title "Developer"
  capacity 1

resource cr002:
  title "Product and release owner"
  capacity 1

