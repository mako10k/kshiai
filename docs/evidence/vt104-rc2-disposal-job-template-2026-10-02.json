{
  "apiVersion": "run.googleapis.com/v1",
  "kind": "Job",
  "metadata": {
    "name": "kshiai-v3-trial-preflight",
    "namespace": "639316264814"
  },
  "spec": {
    "template": {
      "spec": {
        "parallelism": 1,
        "taskCount": 1,
        "template": {
          "spec": {
            "containers": [
              {
                "args": [
                  "--input-type=module",
                  "-e",
                  "// R: Bind the reviewed RC2 plan and real stop-policy evidence to one admin apply and independent readback.\nimport { createHash } from \"node:crypto\";\nimport { writeFileSync } from \"node:fs\";\ntry {\nconst required = (name) => { const value = process.env[name]; if (!value) throw new Error(\"TRIAL_REVIEWED_INPUT_REQUIRED\"); return value; };\nconst planBytes = Buffer.from([0, 1, 2].map((index) => required(`TRIAL_PLAN_PART_${index}`)).join(\"\"), \"base64\");\nif (createHash(\"sha256\").update(planBytes).digest(\"hex\") !== required(\"TRIAL_PLAN_SHA256\")) throw new Error(\"TRIAL_PLAN_BYTES_MISMATCH\");\nconst policy = JSON.parse(Buffer.from(required(\"TRIAL_POLICY_BASE64\"), \"base64\").toString(\"utf8\"));\nif (policy.kind !== \"unreleased-initial-v3-trial\" || !policy.ownerDecisionIdentity || !policy.oldWritersClosedReceiptId) throw new Error(\"TRIAL_STOP_EVIDENCE_REQUIRED\");\nwriteFileSync(\"/tmp/vt104-reviewed-plan.json\", planBytes);\nwriteFileSync(\"/tmp/vt104-real-policy.json\", JSON.stringify(policy));\nconst { runUnreleasedV3TrialPreparation } = await import(\"./backend/dist/scripts/prepare-unreleased-v3-trial.js\");\nconst common = [\"--configured-database\", \"--project-ref\", \"cvrbhpkfqkpqdegxfrlq\", \"--schema\", \"public\", \"--plan\", \"/tmp/vt104-reviewed-plan.json\", \"--expect-plan-sha256\", required(\"TRIAL_PLAN_SHA256\")];\nconst applied = await runUnreleasedV3TrialPreparation([\"apply\", ...common, \"--policy\", \"/tmp/vt104-real-policy.json\", \"--operator-id\", \"mako10k@mk10.org\"]);\nconst readback = await runUnreleasedV3TrialPreparation([\"readback\", ...common]);\nconsole.log(JSON.stringify({ applied, readback }));\n} catch (error) {\n  const reason = error instanceof Error && /^[A-Z][A-Z0-9_]+$/.test(error.message) ? error.message : \"TRIAL_PREPARATION_FAILED\";\n  console.error(JSON.stringify({ error: reason }));\n  process.exitCode = 1;\n}\n"
                ],
                "command": [
                  "node"
                ],
                "env": [
                  {
                    "name": "NODE_ENV",
                    "value": "development"
                  },
                  {
                    "name": "DATABASE_SCHEMA",
                    "value": "public"
                  },
                  {
                    "name": "AUTH_PROVIDER",
                    "value": "supabase"
                  },
                  {
                    "name": "SUPABASE_URL",
                    "value": "https://cvrbhpkfqkpqdegxfrlq.supabase.co"
                  },
                  {
                    "name": "TRIAL_PLAN_SHA256",
                    "value": "6f198d847c5a62036b753eb7179f249aa368a03864b0fd07da09ff589a1520f0"
                  },
                  {
                    "name": "TRIAL_POLICY_BASE64",
                    "value": null
                  },
                  {
                    "name": "TRIAL_PLAN_PART_0",
                    "value": ""
                  },
                  {
                    "name": "TRIAL_PLAN_PART_1",
                    "value": ""
                  },
                  {
                    "name": "TRIAL_PLAN_PART_2",
                    "value": ""
                  },
                  {
                    "name": "DIRECT_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "kshiai-direct-url",
                        "key": "1"
                      }
                    }
                  }
                ],
                "image": "asia-northeast1-docker.pkg.dev/kshiai/kshiai/backend@sha256:2e7051ec6395d36a27124ace0cad8d032bbb6b47878509339b05ce27c679c056",
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                }
              }
            ],
            "maxRetries": 0,
            "serviceAccountName": "kshiai-cloud-run@kshiai.iam.gserviceaccount.com",
            "timeoutSeconds": "120"
          }
        }
      }
    }
  }
}
