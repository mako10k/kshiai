+            const upload = events.findLast((event) => event.type === "version-upload");
+            if (!upload?.version_id) throw new Error("Wrangler did not record a version ID");
+            const previewUrl = new URL(upload.preview_url);
+            if (previewUrl.protocol !== "https:" || !previewUrl.hostname.endsWith(".workers.dev")) {
+              throw new Error("Wrangler did not record a valid version preview URL");
+            }
+            fs.appendFileSync(
+              process.env.GITHUB_OUTPUT,
+              `version=${upload.version_id}\npreview_url=${previewUrl.href}\n`,
+            );
+          '
+
+      - name: Read back the uploaded Worker binding
+        if: inputs.phase == 'deploy'
+        env:
+          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+          BACKEND_URL: ${{ steps.backend.outputs.url }}
+          WORKER_VERSION: ${{ steps.worker.outputs.version }}
+        run: |
+          set -euo pipefail
+          npx wrangler versions view "$WORKER_VERSION" --config "$WRANGLER_CONFIG" --json > "$RUNNER_TEMP/v3-worker-readback.json"
+          node <<'JS'
+          const fs = require("fs");
+          const version = JSON.parse(fs.readFileSync(process.env.RUNNER_TEMP + "/v3-worker-readback.json", "utf8"));
+          if (version.id !== process.env.WORKER_VERSION || !version.resources?.bindings?.some(x => x.name === "BACKEND_ORIGIN" && x.type === "plain_text" && x.text === process.env.BACKEND_URL)) throw new Error("Worker version binding differs");
+          JS
+
+      - name: Verify preparation through the actual edge
+        if: inputs.phase == 'deploy'
+        env:
+          BACKEND_URL: ${{ steps.backend.outputs.url }}
+          PREVIEW_URL: ${{ steps.worker.outputs.preview_url }}
+          REVISION: ${{ steps.backend.outputs.revision }}
+          WORKER_VERSION: ${{ steps.worker.outputs.version }}
+          RELEASE_TAG: ${{ inputs.tag }}
+        run: |
+          set -euo pipefail
+          node scripts/smoke-deployment.mjs "$PREVIEW_URL" "$BACKEND_URL" "$REVISION"
+          node --input-type=module <<'JS'
+          import fs from "node:fs";
+          const health = await fetch(process.env.PREVIEW_URL + "/api/health", {signal:AbortSignal.timeout(20000)});
+          const body = await health.json();
+          const direct = await fetch(process.env.BACKEND_URL + "/api/health", {redirect:"error",signal:AbortSignal.timeout(20000)});
+          const evidence = {schemaVersion:1,evidenceClass:"actual",kind:"preparation",
+            identity:{commitSha:process.env.GITHUB_SHA,imageRef:process.env.IMAGE_REF,revision:process.env.REVISION,workerVersion:process.env.WORKER_VERSION,previewUrl:process.env.PREVIEW_URL,releaseTag:process.env.RELEASE_TAG},
+            startup:{ok:health.ok && body.ok === true,database:body.database,auth:body.auth,revision:body.revision},
+            directProtection:{status:direct.status},worker:{backendUrl:process.env.BACKEND_URL,version:process.env.WORKER_VERSION},preflight:{packetDigest:process.env.PACKET_DIGEST}};
+          fs.writeFileSync(process.env.RUNNER_TEMP + "/v3-trial-preparation.json", JSON.stringify(evidence,null,2) + "\n");
+          JS
+          node scripts/verify-v3-trial-evidence.mjs "$RUNNER_TEMP/v3-trial-preparation.json" --mode preparation
+
+      - name: Resume empty narration queue for the new candidate
+        if: inputs.phase == 'deploy'
+        run: |
+          set -euo pipefail
+          node -e 'if (Date.now() >= Date.parse(process.env.STOP_DEADLINE)) throw new Error("Shared-stop window expired")'
+          gcloud tasks list --queue="$NARRATION_TASK_QUEUE" --project="$GCP_PROJECT" --location="$GCP_REGION" --format=json > "$RUNNER_TEMP/v3-tasks-resume.json"
+          node -e 'if (JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).length !== 0) throw new Error("Unexpected queued tasks; do not resume")' "$RUNNER_TEMP/v3-tasks-resume.json"
+          gcloud tasks queues resume "$NARRATION_TASK_QUEUE" --project="$GCP_PROJECT" --location="$GCP_REGION"
+          gcloud tasks queues describe "$NARRATION_TASK_QUEUE" --project="$GCP_PROJECT" --location="$GCP_REGION" --format='value(state)' | grep -Fx RUNNING
+
+      - name: Retain actual preparation receipt
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        if: inputs.phase == 'deploy'
+        with:
+          name: v3-trial-preparation-${{ github.run_id }}
+          path: ${{ runner.temp }}/v3-trial-preparation.json
+          if-no-files-found: error
+      - name: Show owner trial continuation
+        if: inputs.phase == 'deploy'
+        env:
+          PREVIEW_URL: ${{ steps.worker.outputs.preview_url }}
+        run: |
+          echo "V3 preview prepared: $PREVIEW_URL" >> "$GITHUB_STEP_SUMMARY"
+          echo "Next: Google login, ordinary Neva/Rio review/confirm, selection, advance/SSE/reload/result. Validate a separately observed game receipt; preparation is not game completion." >> "$GITHUB_STEP_SUMMARY"
