+        if: inputs.phase == 'deploy'
+        env:
+          PACKET_JSON: ${{ inputs.execution_packet }}
+          PACKET_SHA256: ${{ inputs.packet_sha256 }}
+          RELEASE_TAG: ${{ inputs.tag }}
+        run: |
+          node --input-type=module <<'JS'
+          import fs from "node:fs";
+          import { createHash } from "node:crypto";
+          const raw = process.env.PACKET_JSON;
+          const digest = createHash("sha256").update(raw ?? "").digest("hex");
+          if (!/^[a-f0-9]{64}$/.test(process.env.PACKET_SHA256 ?? "") || digest !== process.env.PACKET_SHA256) throw new Error("Packet digest mismatch");
