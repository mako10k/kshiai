+          if (receipt.schemaVersion !== 1 || receipt.runId !== String(packet.prepareRunId) || receipt.commitSha !== packet.commitSha || receipt.releaseTag !== packet.releaseTag || receipt.imageRef !== packet.imageRef) throw new Error("Prepared artifact identity mismatch");
