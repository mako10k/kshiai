+        env:
+          GITHUB_TOKEN: ${{ github.token }}
+        run: |
+          node --input-type=module <<'JS'
+          import fs from "node:fs";
+          import { execFileSync } from "node:child_process";
+          const packet = JSON.parse(fs.readFileSync(process.env.RUNNER_TEMP + "/v3-trial-packet.json", "utf8"));
+          const base = `https://api.github.com/repos/${process.env.GITHUB_REPOSITORY}`;
+          const get = async path => {
+            const r = await fetch(base + path, {headers:{Authorization:`Bearer ${process.env.GITHUB_TOKEN}`,Accept:"application/vnd.github+json"},signal:AbortSignal.timeout(30000)});
