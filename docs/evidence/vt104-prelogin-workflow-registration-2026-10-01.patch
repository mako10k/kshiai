+          const assert = (ok, reason) => { if (!ok) throw new Error(reason); };
+          const keys = ["schemaVersion", "commitSha", "releaseTag", "imageRef", "prepareRunId", "targets", "stoppedAt", "expiresAt", "cutoverId", "cutoverAt", "disposalReceiptId", "oldWritersClosedReceiptId", "directUrlSecretVersion", "pendingMigrations", "secretVersions", "maximumWrites", "providerBudgetReceiptId"];
