+
+on:
+  workflow_dispatch:
+    inputs:
+      phase:
+        description: Prepare an image before shared stopping, or deploy an exact reviewed packet
+        required: true
+        type: choice
+        options: [prepare, deploy]
+      tag:
+        description: Existing annotated release tag; dispatch from this same tag
+        required: true
+        type: string
+      execution_packet:
+        description: For deploy only, credential-free JSON with exact targets, readbacks, secret versions and write bounds
+        required: false
+        type: string
+      packet_sha256:
+        description: For deploy only, SHA256 of the exact UTF-8 execution_packet input
+        required: false
+        type: string
