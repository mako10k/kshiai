  accepted_basis sha256:f47bd29dd68aad780eef5c3d64e205470bc2dfff92d0f672dcd115f7d45746cd
  accepted_inputs:
    T_HELD_OUT_PROTOCOL both sha256:8559a87f3450c5f6e5dba64fc8b0fc9a74712730ff22c27e05805153338265b3
  reason "Accept the applicability decision lineage, fixed thirty-case oracle matrix, six integration controls, strict effectiveness metrics, stop conditions, four-point estimate, and runtime non-authorization boundary"

