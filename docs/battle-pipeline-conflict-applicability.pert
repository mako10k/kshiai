# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project KSHIAI_BATTLE_PIPELINE_CONFLICT_APPLICABILITY:
  version 6
  title "Conflict-handling applicability PoC"
  description "Test whether conflict and unknown handling applicability can be separated from fallback capability in the local integrated shadow PoC. Freeze a versioned additive receipt, deterministic counterexamples, seven pre-registered classifications, three applicable strata, strict legacy parity, unchanged hard boundaries, and a 140-run decision. This plan does not authorize historical evidence rewrites, legacy field reinterpretation, runtime wiring, canonical writes, external LLM or XAI calls, persistence, release, or deployment."
  as_of 2026-08-06
  duration_unit point
  velocity 453p/128d
  finish APPLICABILITY_REPLAY_DECIDED
  goal_owner user
  dag_owner user
  plan_assurance_model 1
  plan_assurance_hash_model 1

milestone REVISE_DECISION_ACCEPTED:
  title "Corrective replay revise decision accepted"
  state reached

resource DEV:
  title "Developer"
  capacity 1

milestone APPLICABILITY_PROTOCOL_FIXED:
  title "Conflict-handling applicability protocol fixed"
  state reached

milestone APPLICABILITY_RECEIPT_BUILT:
  title "Versioned applicability receipt built"
  state reached

milestone APPLICABILITY_REPLAY_DECIDED:
  title "Applicability replay evaluated and decided"

task T_APPLICABILITY_PROTOCOL REVISE_DECISION_ACCEPTED -> APPLICABILITY_PROTOCOL_FIXED:
  title "Freeze conflict-handling applicability semantics"
  description "Separate fallback capability, observed applicability triggers, handling evidence, and not-needed disposition. Register seven expected classifications, exactly three applicable strata, counterexamples, metrics, stop conditions, frozen lineage, and the XAI non-use rule before implementation."
  duration 1p
  status done
  requires:
    DEV 1

task T_APPLICABILITY_RECEIPT APPLICABILITY_PROTOCOL_FIXED -> APPLICABILITY_RECEIPT_BUILT:
  title "Build the versioned applicability receipt"
  description "Add a deterministic v2 envelope and counterexample tests without changing the legacy receipt or authoritative behavior. Record capability, trigger, handling, disposition, stable refs, and a legacy projection that removes only the new envelope."
  duration 1p
  status done
  requires:
    DEV 1

task T_APPLICABILITY_REPLAY_DECISION APPLICABILITY_RECEIPT_BUILT -> APPLICABILITY_REPLAY_DECIDED:
  title "Evaluate and decide the applicability replay"
  description "Replay seven corrective-v2 strata twenty times. Require exact classification and disposition, three applicable strata, handled over required equal to one, seven-of-seven legacy parity and battle behavior, deterministic stability, hard boundaries, and a supported revise unsupported or indeterminate decision."
  duration 1p
  requires:
    DEV 1

