# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project KSHIAI_BATTLE_PIPELINE_HYPOTHESIS_SLICE:
  version 6
  title "Battle-pipeline hypothesis-first production slice"
  description "Implement the most axial and current-main-patchable battle-pipeline hypotheses before observation: actual-turn source authoring with compact purpose projections, a proposal-to-committed-result causal receipt, and one guarded narration consumer. Observation backlog items are secondary evaluation lenses, not the source of implementation priority."
  as_of 2026-08-07
  duration_unit day
  finish NEXT_HYPOTHESIS_SELECTED
  goal_owner user
  dag_owner user
  target_duration 10d

resource DEV:
  title "Developer"
  capacity 1

resource OWNER:
  title "Product and release owner"
  capacity 1

milestone MAIN_BASE_FIXED:
  title "Current main baseline fixed"
  description "Implementation base is main commit 4c7ea5ccec31814a5fa38f1b9ea616ca50e764fe; the preserved PoC supplies hypothesis code and evidence only after current-main reduction and review"
  state reached

milestone SOURCE_PROJECTION_IMPLEMENTED:
  title "Actual-turn source authoring and compact projections implemented"

milestone CAUSAL_RECEIPT_IMPLEMENTED:
  title "Proposal-to-result causal receipt implemented"

milestone FIRST_CONSUMER_IMPLEMENTED:
  title "First guarded pipeline consumer implemented"

milestone PIPELINE_IMPLEMENTATION_ACCEPTED:
  title "Patchable hypothesis slice accepted locally"

milestone STAGING_TRIAL_COMPLETED:
  title "Implemented pipeline tried in staging"

milestone GUARDED_TRIAL_DECIDED:
  title "Guarded production trial explicitly decided"

milestone GUARDED_TRIAL_COMPLETED:
  title "Guarded production trial completed or explicitly declined"

milestone NEXT_HYPOTHESIS_SELECTED:
  title "Next axial hypothesis selected from implementation evidence"

task T_IMPLEMENT_SOURCE_PROJECTION MAIN_BASE_FIXED -> SOURCE_PROJECTION_IMPLEMENTED:
  title "Implement the source-authoring and projection axis on current main"
  description "Reduce and port the relevant actual-turn source-authoring and compact purpose-projection ideas from the PoC into current main. Capture explicit values at their existing owner stages and expose only the bounded decision adjudication and narration slices needed by this vertical path. Define minimum executable schemas authority privacy and fallback invariants inside the implementation; do not run a separate exhaustive contract-freeze phase or import the PoC branch wholesale."
  duration 2d
  owner "codex"
  requires:
    DEV 1

task T_IMPLEMENT_CAUSAL_RECEIPT SOURCE_PROJECTION_IMPLEMENTED -> CAUSAL_RECEIPT_IMPLEMENTED:
  title "Connect proposals adjudication and committed effects in one receipt"
  description "Build a bounded receipt over existing requested and effective actions engine decisions committed events mechanical effects accepted world or semantic changes observer-visible consequences and current-turn unresolved markers. Preserve existing BattleState engine repository and semantic authorities. Reject unsupported links and fall back to the legacy path; do not add persistence a canonical database general repair or a new LLM call."
  duration 2d
  owner "codex"
  requires:
    DEV 1

task T_WIRE_FIRST_CONSUMER CAUSAL_RECEIPT_IMPLEMENTED -> FIRST_CONSUMER_IMPLEMENTED:
  title "Wire narration as the first guarded pipeline consumer"
  description "Pass the compact committed projection and causal receipt to the existing narrator request behind a reversible default-off guard. Reuse the existing narrator call and forbid changes to actions mechanics state winner rating character cognition or provider ordering. Add only the diagnostics needed for the first comparison."
  duration 1d
  owner "codex"
  requires:
    DEV 1

task T_ACCEPT_IMPLEMENTED_PIPELINE FIRST_CONSUMER_IMPLEMENTED -> PIPELINE_IMPLEMENTATION_ACCEPTED:
  title "Accept the implemented hypothesis slice before trial"
  description "Run focused authority privacy malformed-input fallback and control-path regression tests plus full tests typecheck build and PERT checks. Require exact off-mode behavior and no unexpected provider repository persistence or domain writes. This is bounded engineering acceptance of the first concept slice, not proof of the generalized architecture."
  duration 1d
  owner "codex"
  requires:
    DEV 1

task T_TRIAL_STAGING PIPELINE_IMPLEMENTATION_ACCEPTED -> STAGING_TRIAL_COMPLETED:
  title "Try the implemented pipeline in staging"
  description "Deploy the accepted immutable artifact to staging and run synthetic or disposable authenticated battles through the actual guarded consumer. Compare baseline and candidate causal clarity concrete progress unsupported claims fallback privacy latency and cost. Check open observation backlog items only as secondary scorecards and retain any continuing phenomenon without automatically scheduling a local patch."
  duration 1d
  owner "codex"
  requires:
    DEV 1

task T_DECIDE_GUARDED_TRIAL STAGING_TRIAL_COMPLETED -> GUARDED_TRIAL_DECIDED:
  title "Decide the bounded production trial from staging evidence"
  description "Approve revise defer or reject a reversible production trial. If approved bind the exact artifact mode cohort ceiling comparison method limits rollback operator and hold time from the implemented behavior and staging evidence. This decision does not grant mechanical authority or authorize an unrelated backlog-fix queue."
  duration 1d
  owner "user"
  requires:
    OWNER 1

task T_TRIAL_GUARDED_RUNTIME GUARDED_TRIAL_DECIDED -> GUARDED_TRIAL_COMPLETED:
  title "Run or record the guarded production trial decision"
  description "For an approved cohort enable only the accepted guarded narration path and compare it with baseline while preserving mechanical authority and rollback. If the owner defers or rejects the trial record that disposition without deployment. Stop on factual invention privacy leakage mechanical divergence unexpected calls or rollback failure."
  duration 1d
  owner "codex"
  requires:
    DEV 1

task T_SELECT_NEXT_HYPOTHESIS GUARDED_TRIAL_COMPLETED -> NEXT_HYPOTHESIS_SELECTED:
  title "Select the next axial and patchable hypothesis"
  description "Rank adaptive adjudication active environment or world processes and any other surviving pipeline axes by centrality to the hypothesis current-main patchability expected user value and evidence from the completed slice. Observation backlog items contribute only when they still reproduce; they do not replace the hypothesis sequence. Record whether to extend revise or stop before beginning another slice."
  duration 1d
  owner "user"
  requires:
    OWNER 1
