# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project KSHIAI_BATTLE_PIPELINE_PRODUCTION_ROLLOUT:
  version 6
  title "Battle-pipeline production staged rollout"
  description "Progressively adopt the battle-pipeline source-authoring and conflict-handling path from disabled code through staging, production shadow cohorts, explicit effect authority, guarded effect canaries, and full production acceptance. Every stage is fail-closed for evidence and fail-open to the existing battle path. This plan never authorizes raw prose or identity telemetry, unbounded retention, implicit traffic expansion, nondeterministic mechanical writes, or bypass of the repository release and rollback process."
  as_of 2026-08-06
  duration_unit point
  velocity 453p/128d
  finish ROLLOUT_ACCEPTED
  goal_owner user
  dag_owner user
  plan_assurance_model 1
  plan_assurance_hash_model 1
  target_duration 19p

milestone POC_CLOSED:
  title "Exploratory PoC phase closed"
  state reached

resource DEV:
  title "Developer"
  capacity 1

resource OWNER:
  title "Release and product owner"
  capacity 1

milestone ROLLOUT_CONTRACT_FIXED:
  title "Production rollout contract and stop policy fixed"

milestone DISABLED_RELEASE_READY:
  title "Production-safe disabled release ready"

milestone STAGING_ACCEPTED:
  title "Staging shadow acceptance complete"

milestone PRODUCTION_BASELINE_ACCEPTED:
  title "Production disabled baseline accepted"

milestone SHADOW_ONE_PERCENT_ACCEPTED:
  title "One-percent production shadow accepted"

milestone SHADOW_TEN_PERCENT_ACCEPTED:
  title "Ten-percent production shadow accepted"

milestone SHADOW_FULL_ACCEPTED:
  title "Full production shadow accepted"

milestone EFFECT_AUTHORITY_DECIDED:
  title "Effectful production authority explicitly decided"

milestone EFFECT_CANARY_ACCEPTED:
  title "Effectful guarded canary accepted"

milestone EFFECT_FULL_ACCEPTED:
  title "Effectful full rollout accepted"

milestone ROLLOUT_ACCEPTED:
  title "Production rollout closed with evidence"

task T_FREEZE_ROLLOUT_CONTRACT POC_CLOSED -> ROLLOUT_CONTRACT_FIXED:
  title "Freeze production rollout, privacy, SLO, and rollback contracts"
  description "Define the five owner-stage runtime hook points, versioned feature configuration, deterministic cohorting, aggregate-only telemetry allow-list, retention, dashboards, success thresholds, stop conditions, kill switch, owners, rollback targets, and evidence receipt. Preserve the boundary that LLMs may author semantics while deterministic validated code alone selects and persists mechanics."
  duration 2p
  requires:
    DEV 1
  owner "codex"

task T_BUILD_DISABLED_RELEASE ROLLOUT_CONTRACT_FIXED -> DISABLED_RELEASE_READY:
  title "Build production wiring disabled by default"
  description "Wire all five source-authoring owners into the ordinary runtime behind one versioned server-side mode set to off. Keep artifacts in memory, emit only allowed aggregate counters, ignore shadow returns, add bounded timeouts and circuit breaker behavior, retain exact legacy fallback, and add unit integration load privacy and rollback tests. No raw prose identity source bundle or per-turn hash may be durably logged."
  duration 3p
  requires:
    DEV 1
  owner "codex"

task T_ACCEPT_STAGING_SHADOW DISABLED_RELEASE_READY -> STAGING_ACCEPTED:
  title "Stage immutable artifacts and accept shadow behavior"
  description "Use the tagged build-once release flow to deploy a no-traffic Cloud Run revision and Worker preview, enable shadow only in staging, exercise synthetic and disposable authenticated battles, inject observer and telemetry failures, verify exact legacy result parity and zero extra domain writes, then record image revision Worker version migration and rollback evidence."
  duration 2p
  requires:
    DEV 1
  owner "codex"

task T_ACCEPT_PRODUCTION_BASELINE STAGING_ACCEPTED -> PRODUCTION_BASELINE_ACCEPTED:
  title "Promote with feature off and establish production baseline"
  description "Promote the exact staged artifacts with mode off through the protected production workflow. Soak at least twenty-four hours and record battle success rate backend error rate p50 and p95 turn latency provider calls and domain writes. Verify the kill switch and known-good Cloud Run and Worker rollback targets before any shadow traffic."
  duration 1p
  requires:
    DEV 1
  owner "codex"

task T_ACCEPT_SHADOW_ONE_PERCENT PRODUCTION_BASELINE_ACCEPTED -> SHADOW_ONE_PERCENT_ACCEPTED:
  title "Run one-percent production shadow canary"
  description "Enable deterministic one-percent eligible-turn shadowing without user-visible or persistent mechanical effects. Hold at least twenty-four hours and one hundred eligible turns; if volume is insufficient remain at one percent. Require zero parity divergence, zero extra domain writes, zero privacy violations, observer errors below one percent, and p95 turn latency regression no greater than ten percent or twenty milliseconds, whichever is stricter."
  duration 2p
  requires:
    DEV 1
  owner "codex"

task T_ACCEPT_SHADOW_TEN_PERCENT SHADOW_ONE_PERCENT_ACCEPTED -> SHADOW_TEN_PERCENT_ACCEPTED:
  title "Expand production shadow to ten percent"
  description "Expand only by reviewed configuration receipt to ten percent. Hold at least forty-eight hours and five hundred eligible turns with the same hard parity write privacy and latency gates, plus no material increase in backend errors provider calls or circuit-breaker trips. Any gate breach returns immediately to off and opens an incident record."
  duration 1p
  requires:
    DEV 1
  owner "codex"

task T_ACCEPT_SHADOW_FULL SHADOW_TEN_PERCENT_ACCEPTED -> SHADOW_FULL_ACCEPTED:
  title "Expand production shadow through fifty to one hundred percent"
  description "Advance through fifty percent and one hundred percent as separate recorded configuration changes. Hold each for at least seventy-two hours; require all prior hard gates, bounded telemetry cardinality and cost, and at least one successful kill-switch drill. Full shadow acceptance authorizes observation only and does not authorize mechanical effects."
  duration 2p
  requires:
    DEV 1
  owner "codex"

task T_DECIDE_EFFECT_AUTHORITY SHADOW_FULL_ACCEPTED -> EFFECT_AUTHORITY_DECIDED:
  title "Decide whether production effects may begin"
  description "Review the complete shadow receipt and explicitly choose approve revise defer or reject. Approval must name the eligible low-risk decision class, mechanical validator, fallback behavior, cohort ceiling, monitoring window, rollback operator, and non-claims. Without an explicit conformant owner outcome all effectful tasks remain blocked and shadow mode stays non-authoritative."
  duration 1p
  requires:
    OWNER 1
  owner "user"

task T_ACCEPT_EFFECT_CANARY EFFECT_AUTHORITY_DECIDED -> EFFECT_CANARY_ACCEPTED:
  title "Run guarded effectful canaries"
  description "After explicit approval enable only the named low-risk class for an owner cohort then one percent of eligible turns. Deterministic validators remain authoritative, incomplete ambiguous contested timeout or error cases use the legacy path, and no LLM prose directly selects mechanics. Hold each canary at least forty-eight hours and stop on any unauthorized write, invariant breach, material battle-error regression, or rollback failure."
  duration 2p
  requires:
    DEV 1
  owner "codex"

task T_ACCEPT_EFFECT_FULL EFFECT_CANARY_ACCEPTED -> EFFECT_FULL_ACCEPTED:
  title "Ramp guarded effects through ten, fifty, and one hundred percent"
  description "Advance through ten fifty and one hundred percent with separate receipts and minimum seventy-two-hour soaks. Preserve the approved eligibility ceiling, compare product and reliability metrics with the disabled baseline, retain immediate off switch and artifact rollback, and require owner review before each expansion. Database schema contraction is excluded from this rollout."
  duration 2p
  requires:
    DEV 1
  owner "codex"

task T_CLOSE_ROLLOUT EFFECT_FULL_ACCEPTED -> ROLLOUT_ACCEPTED:
  title "Close rollout and freeze operating evidence"
  description "Record the accepted release and configuration receipts, stage metrics, incidents, residual risks, support and rollback runbooks, telemetry retention deletion, and the final enabled scope. Remove temporary canary controls only after a later compatible release and keep the global off switch. Open separate plans for scope expansion, model changes, persistence changes, or classifier retraining."
  duration 1p
  requires:
    OWNER 1
  owner "user"

