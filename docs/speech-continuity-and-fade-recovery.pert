project SPEECH_CONTINUITY_FADE:
  version 5
  title "Speech recovery and economic consciousness policy design"
  description "Current owner goal: maintain a current valid canonical PERT, follow justified dag next, deploy the normal awareness pipeline and complete one public match. Held old cutover verification is a separate preserved branch; overall plan closure requires both branches, current public delivery is AWARENESS_PUBLIC_COMPLETED."
  duration_unit point
  velocity 1p/1h
  finish ALL_PLAN_WORK_RESOLVED
resource DEV:
  title "Developer"
  capacity 1
milestone AUTHORIZED:
  title "Owner requests both fixes"
  state reached
milestone FIXED:
  title "Continuity prompt prepared and speech fade removed"
task repair AUTHORIZED -> FIXED:
  title "Prepare exact exchange anchors and delete speech animation and reveal timers"
  duration 1p
  status done
  requires:
    DEV 1
milestone VERIFIED:
  title "Regressions and live-model probes verified"
task verify FIXED -> VERIFIED:
  title "Unit browser repository and bounded frozen model checks"
  duration 0.5p
  status done
  requires:
    DEV 1
milestone LIVE:
  title "Verified source deployed"
task release VERIFIED -> LIVE:
  title "Commit push and deploy after CI preview checks"
  duration 0.3p
  status done
  requires:
    DEV 1

milestone POLICY_DRAFT_READY:
  title "Economic consciousness operating-policy candidate authored and reviewed"

task policy-draft LIVE -> POLICY_DRAFT_READY:
  title "Specify activation latency budget and finite failure policies"
  description "Owner proceed on 2026-10-05. Draft policy, ADR0050 revision3 projection, bounded review and audit. Candidate policies do not accept runtime contracts."
  duration 1p
  status done
  requires:
    DEV 1
  source "docs/battle-consciousness-operating-policy-2026-10-05.md"

task model-compatibility POLICY_DRAFT_READY -> COMPATIBILITY_READY:
