# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project KSHIAI_BATTLE_PIPELINE_ACTUAL_TURN_SHADOW_OBSERVATION:
  version 6
  title "Actual-turn read-only shadow observation PoC"
  description "Closed PoC evidence plan. The final in-memory ordinary-turn shadow source-assembly PoC passed its frozen non-interference gates and ends the exploratory PoC phase. Historical downstream actual-sample and observation tasks remain recorded for traceability but are superseded and must not be started from this plan. Runtime adoption, actual data access, persistence, release, and deployment require the separate production staged-rollout plan and its explicit gates."
  as_of 2026-08-06
  duration_unit point
  velocity 453p/128d
  finish OBSERVATION_DECIDED
  goal_owner user
  dag_owner user
  plan_assurance_model 1
  plan_assurance_hash_model 1

milestone HELD_OUT_GENERALIZATION_SUPPORTED:
  title "Held-out conflict-handling generalization supported"
  state reached

milestone OBSERVATION_PROTOCOL_FIXED:
  title "Actual-turn shadow observation protocol fixed"
  state reached

milestone OFFLINE_OBSERVER_READY:
  title "Offline read-only observer and source sufficiency audit ready"
  state reached

milestone CAPTURE_AUTHORITY_DECIDED:
  title "Exact actual-turn capture authority decided"
  state reached

milestone ACTUAL_SAMPLE_FROZEN:
  title "Approved privacy-safe actual-turn sample frozen"

milestone OBSERVATION_EVALUATED:
  title "Actual-turn observation effectiveness and distribution evaluated"

milestone OBSERVATION_DECIDED:
  title "Actual-turn shadow observation limitations and next gate recorded"

resource DEV:
  title "Developer"
  capacity 1

task T_OBSERVATION_PROTOCOL HELD_OUT_GENERALIZATION_SUPPORTED -> OBSERVATION_PROTOCOL_FIXED:
  title "Freeze actual-turn observation semantics"
  description "Freeze the existing persisted-record insufficiency, server-only envelope, privacy and authority boundary, offline-only adapter contract, sample sufficiency, metrics, descriptive distribution, decision rubric, stop conditions, capture-approval requirements, and non-claims before implementation."
  duration 1p
  status done
  requires:
    DEV 1

task T_OFFLINE_OBSERVER OBSERVATION_PROTOCOL_FIXED -> OFFLINE_OBSERVER_READY:
  title "Build the offline read-only observation adapter"
  description "Add a strict versioned envelope and local-file-only adapter that validates explicit inputs, hashes source bytes before and after, reports persisted-record field insufficiency without inference, redacts direct identity and prose, and has no DB network provider external LLM XAI canonical persistence or runtime imports."
  duration 2p
  status done
  requires:
    DEV 1

task T_CAPTURE_AUTHORITY_DECISION OFFLINE_OBSERVER_READY -> CAPTURE_AUTHORITY_DECIDED:
  title "Decide exact actual-turn capture authority"
  description "Freeze the exact hook point read allow-list zero-write enforcement ignored destination maximum records duration pseudonymization timeout fail-open behavior environment identity disable and rollback procedure, then obtain an explicit user decision before any runtime hook implementation activation DB or network access."
  duration 1p
  status done
  requires:
    DEV 1

task T_ACTUAL_SAMPLE CAPTURE_AUTHORITY_REVIEWED_V2 -> ACTUAL_SAMPLE_FROZEN:
  title "Capture the approved actual-turn sample"
  description "Only after a conformant explicit T_CAPTURE_AUTHORITY_REVIEW_V2 outcome capture the first eligible privacy-safe envelopes into an ignored local source require at least fifty turns across ten battles and two dates commit only a redacted digest manifest and stop indeterminate rather than accessing another environment or fabricating missing samples."
  duration 2p
  requires:
    DEV 1

task T_OBSERVATION_EVAL ACTUAL_SAMPLE_FROZEN -> OBSERVATION_EVALUATED:
  title "Evaluate observation effectiveness and distribution"
  description "Replay each frozen envelope twenty times and require schema lineage mutation privacy completeness structural-reference determinism and latency gates while reporting trigger handling disposition insufficiency and held-out distribution differences descriptively without treating classifier output as oracle truth."
  duration 2p
  requires:
    DEV 1

task T_OBSERVATION_DECISION OBSERVATION_EVALUATED -> OBSERVATION_DECIDED:
  title "Record observation limitations and next gate"
  description "Decide supported revise unsupported or indeterminate for the read-only observation method only, preserve the absence of an actual-turn accuracy oracle, and keep classifier changes runtime adoption persistence release and deployment separately gated."
  duration 1p
  requires:
    DEV 1

milestone INPUT_DERIVATION_PROTOCOL_FIXED:
  title "Applicability input derivation protocol fixed"
  state reached

milestone INPUT_DERIVATION_POC_READY:
  title "Offline applicability input derivation PoC ready"
  state reached

milestone INPUT_DERIVATION_EVALUATED:
  title "Applicability input derivability evaluated"
  state reached

milestone CAPTURE_AUTHORITY_REVIEWED:
  title "Actual-turn capture authority reviewed after derivability PoC"
  state reached

task T_INPUT_DERIVATION_PROTOCOL CAPTURE_AUTHORITY_DECIDED -> INPUT_DERIVATION_PROTOCOL_FIXED:
  title "Freeze applicability input derivation protocol"
  description "Freeze a field-by-field authoritative source map for allowedFallbacks proposals adaptive reads and issues; define source-produced versus derived or inferred data, preregistered fixtures, effectiveness metrics, fail-closed behavior, and the boundary excluding runtime hooks DB network provider LLM XAI canonical writes persistence release and deployment."
  duration 1p
  status done
  requires:
    DEV 1

task T_INPUT_DERIVATION_POC INPUT_DERIVATION_PROTOCOL_FIXED -> INPUT_DERIVATION_POC_READY:
  title "Build offline applicability input derivation PoC"
  description "Build a pure offline derivability probe over explicit local fixtures and runtime-shaped values. It must emit source provenance for every required field, never infer from events prose cognition speech or narration, reject missing or ambiguous sources, preserve input bytes, and leave battle and runtime services untouched."
  duration 2p
  status done
  requires:
    DEV 1

task T_INPUT_DERIVATION_EVAL INPUT_DERIVATION_POC_READY -> INPUT_DERIVATION_EVALUATED:
  title "Evaluate applicability input derivability"
  description "Evaluate at least fifteen preregistered cases spanning all five required input areas plus missing and ambiguous controls. Require complete provenance for every emitted field, zero inferred fields, rejection of every missing required source, identical output over twenty replays, unchanged input digests, and record supported revise unsupported or indeterminate without treating classifier output as oracle truth."
  duration 2p
  status done
  requires:
    DEV 1

task T_CAPTURE_AUTHORITY_REVIEW INPUT_DERIVATION_EVALUATED -> CAPTURE_AUTHORITY_REVIEWED:
  title "Review actual-turn capture authority after derivability PoC"
  description "Freeze the PoC evidence and exact future capture candidate, then obtain a new explicit user decision. Only a conformant approval can unlock runtime hook implementation or actual sampling; a changed unsupported or indeterminate outcome keeps them assurance-withheld."
  duration 1p
  status done
  requires:
    DEV 1

milestone SOURCE_AUTHORING_PROTOCOL_FIXED:
  title "Source-authoring protocol fixed"
  state reached

milestone SOURCE_AUTHORING_CORE_READY:
  title "Pure owner-stage source-authoring PoC ready"
  state reached

milestone SOURCE_AUTHORING_SHADOW_READY:
  title "In-memory ordinary-turn shadow source assembly ready"

milestone SOURCE_AUTHORING_EVALUATED:
  title "Source-authoring availability and non-interference evaluated"

milestone CAPTURE_AUTHORITY_REVIEWED_V2:
  title "Actual-turn capture authority reviewed after source-authoring PoC"

task T_SOURCE_AUTHORING_PROTOCOL CAPTURE_AUTHORITY_REVIEWED -> SOURCE_AUTHORING_PROTOCOL_FIXED:
  title "Freeze source-authoring and non-interference protocol"
  description "Freeze one semantic owner stage for each of turn fallback policy coarse proposal registry adaptive stage receipt purpose read set and consistency issue snapshot; define exact source fields lifecycle provenance invariants runtime-shaped deterministic fixtures availability and parity metrics decision rubric fail-open and fail-closed behavior stop conditions and the boundary excluding actual data capture DB network external providers LLM XAI persistence release and deployment."
  duration 1p
  status done
  requires:
    DEV 1

task T_SOURCE_AUTHORING_CORE_POC SOURCE_AUTHORING_PROTOCOL_FIXED -> SOURCE_AUTHORING_CORE_READY:
  title "Build pure owner-stage source-authoring PoC"
  description "Build pure constructors for the five explicit source artifacts over runtime-shaped local fixtures. Every emitted field must carry exact source provenance; missing ambiguous or cross-inconsistent sources must fail closed; no resolved actions events prose cognition speech narration or fallback outcomes may be used as proxies; and input bytes battle results runtime services and persistence remain unchanged."
  duration 2p
  status done
  requires:
    DEV 1

task T_SOURCE_AUTHORING_SHADOW_POC SOURCE_AUTHORING_CORE_READY -> SOURCE_AUTHORING_SHADOW_READY:
  title "Build in-memory ordinary-turn shadow source assembly PoC"
  description "Add a disabled-by-default fail-open in-memory seam exercised only by deterministic local ordinary-turn fixtures to assemble the five owner-stage artifacts. Compare control and shadow outcome next-state narration-input call-trace and persistence-candidate digests; perform no actual-turn data capture DB network provider external LLM XAI canonical battle or persistence writes; and leave production and normal development behavior unchanged."
  duration 2p
  status done
  requires:
    DEV 1

task T_SOURCE_AUTHORING_EVAL SOURCE_AUTHORING_SHADOW_READY -> SOURCE_AUTHORING_EVALUATED:
  title "Evaluate source availability and non-interference"
  description "Evaluate preregistered positive missing ambiguous contested partial and fail-open ordinary-turn fixtures over twenty replays. Require all five authoritative artifacts for every eligible case complete provenance zero inference rejection of invalid sources deterministic outputs unchanged inputs exact control versus shadow parity and zero extra DB network provider external LLM XAI canonical battle or persistence writes; record supported revise unsupported or indeterminate without treating classifier output as oracle truth."
  duration 2p
  status blocked
  requires:
    DEV 1
  blocked_reason "Superseded by the user-directed end of the exploratory PoC phase after T_SOURCE_AUTHORING_SHADOW_POC passed. Continue only through the separate production staged-rollout plan."

task T_CAPTURE_AUTHORITY_REVIEW_V2 SOURCE_AUTHORING_EVALUATED -> CAPTURE_AUTHORITY_REVIEWED_V2:
  title "Review actual-turn capture authority after source-authoring PoC"
  description "Freeze source-authoring effectiveness evidence and the exact future capture candidate then obtain a new explicit user decision. Only a conformant approval can unlock actual sampling; a changed unsupported or indeterminate outcome keeps runtime capture activation actual data DB network persistence release and deployment assurance-withheld."
  duration 1p
  requires:
    DEV 1

