project KSHIAI_BATTLE_PIPELINE_INTEGRATED_SHADOW_POC:
  version 6
  title "Integrated shadow-turn evidence plan"
  description |
    Evaluate whether the supported bounded battle-pipeline PoCs can compose on
    one frozen turn transcript without changing the current authoritative
    BattleState or battle outcome. Freeze transcript inputs and thresholds before
    implementation, build a shared-only integrated receipt, and measure
    dependency recall privacy authority causal trace temporal atomicity calls
    tokens latency and unknown fallback. This plan does not authorize runtime
    service wiring canonical commit database migration provider-order changes
    release or deployment. Supported means only that the bounded shadow
    experiment justifies a separately gated next engineering decision.
  as_of 2026-08-06
  duration_unit point
  velocity 453p/128d
  finish SHADOW_DECISION_RECORDED
  plan_assurance_model 1
  plan_assurance_hash_model 1

resource DEV:
  title "Developer"
  capacity 1

milestone PRIOR_POC_SYNTHESIZED:
  title "Prior bounded PoC evidence synthesis accepted as input"
  state reached

milestone SHADOW_PROTOCOL_FIXED:
  title "Integrated shadow-turn hypotheses boundaries and thresholds fixed"
  state reached

milestone TRANSCRIPT_BASELINE_FROZEN:
  title "Versioned turn transcripts and authoritative baseline frozen"
  state reached

milestone INTEGRATED_RECEIPT_BUILT:
  title "Shared-only integrated shadow-turn receipt built"
  state reached

milestone INTEGRATED_RECEIPT_EVALUATED:
  title "Integrated receipt effectiveness and failure modes evaluated"

milestone SHADOW_DECISION_RECORDED:
  title "Integrated shadow-turn limitations and next gate recorded"

task T_SHADOW_PROTOCOL PRIOR_POC_SYNTHESIZED -> SHADOW_PROTOCOL_FIXED:
  title "Freeze the integrated shadow-turn evaluation protocol"
  description |
    Fix the authority boundary transcript contract scenario strata metrics hard
    invariants proxy thresholds decision rubric and explicit non-claims before
    transcript capture or implementation. Keep current BattleState and battle
    results authoritative and preserve live call reduction as unmeasured.
  duration 1p
  status done
  requires:
    DEV 1

task T_TRANSCRIPT_BASELINE SHADOW_PROTOCOL_FIXED -> TRANSCRIPT_BASELINE_FROZEN:
  title "Capture fixed turn transcripts and authoritative controls"
  description |
    Add a versioned corpus and repeatable local capture harness for ordinary
    remote simultaneous interrupted world-process blocking-conflict and
    exhausted-budget cases. Record schema-valid source BattleState authoritative
    result proposals expected dependencies boundaries call model provenance and
    hashes without external LLM calls or runtime service writes.
  duration 2p
  status done
  requires:
    DEV 1

task T_INTEGRATED_RECEIPT_POC TRANSCRIPT_BASELINE_FROZEN -> INTEGRATED_RECEIPT_BUILT:
  title "Build a shared-only integrated shadow-turn receipt"
  description |
    Compose compact projections derived graph queries adaptive and world
    proposals patch audit issue registration and bounded read coherence into one
    schema-validated receipt. Preserve sourceMutated false
    authoritativeOutcomeChanged false and canonicalCommitPerformed false.
  duration 3p
  status done
  requires:
    DEV 1

task T_INTEGRATED_RECEIPT_EVAL INTEGRATED_RECEIPT_BUILT -> INTEGRATED_RECEIPT_EVALUATED:
  title "Evaluate integrated shadow-turn effectiveness and interference"
  description |
    Run the frozen corpus for twenty deterministic repetitions and measure hard
    invariants dependency recall receipt coverage conflict handling digest
    stability latency bytes calls and tokens. Use blind semantic review only if
    deterministic evidence cannot decide the registered question and record
    supported revise unsupported or indeterminate without changing thresholds.
  duration 2p
  requires:
    DEV 1

task T_SHADOW_DECISION INTEGRATED_RECEIPT_EVALUATED -> SHADOW_DECISION_RECORDED:
  title "Record integration limitations interactions and the next gate"
  description |
    Separate component evidence from integration effects and record failures
    unknowns and superseded measurements. Decide only whether another bounded
    engineering experiment is justified. Keep runtime persistence provider
    release deployment and objective battle correctness separately gated.
  duration 1p
  requires:
    DEV 1

