# GitHub Issue #98 implementation plan. Local acceptance is not release
# authorization; owner gates decide only the listed product contracts.
project KSHIAI_ISSUE_98_CAUSAL_BATTLE_PIPELINE:
  version 6
  title "Issue #98 causal battle-pipeline renewal"
  description "Replanned from baseline bc47793 while preserving the original active-task estimate and work events. Finish the pure restartable bucket engine, then audit and integrate the already-written continuation persistence, administrator checkpoint display, and isolated-side agent groundwork before proceeding through asset generations and pipeline-wide LLM cost gates. Do not treat groundwork commits as completed downstream tasks. Private psyche, action, expression, adjudication, and narration contexts remain separate; neural training, embedding, LLM judging, and data-review infrastructure remain deferred."
  as_of 2026-08-12
  duration_unit point
  velocity 2880p/1117h
  target_duration 49p
  finish ISSUE_98_LOCALLY_ACCEPTED

resource DEV:
  title "Developer"
  capacity 1

resource OWNER:
  title "Product and release owner"
  capacity 1

milestone ISSUE_INTAKE_RECORDED:
  title "Issue intent and current baseline recorded"
  state reached

milestone CAUSAL_CONTRACT_DRAFTED:
  title "Causal state machine and authority draft recorded"
  state reached

milestone CAUSAL_CONTRACT_ACCEPTED:
  title "Owner accepted bounded Phase 1 contract"
  state reached

milestone BUCKET_ENGINE_READY:
  title "Restartable bucket execution is available"

milestone EARLY_GROUNDWORK_AUDITED:
  title "Early persistence, visibility, and side-isolation groundwork is integrated"

milestone ASSET_GENERATIONS_READY:
  title "Battles bind immutable editable-asset generations"

milestone LLM_COST_CONTRACT_ACCEPTED:
  title "Owner accepted pipeline-wide LLM cost budgets and routing"

milestone PSYCHE_CALL_CONTRACT_ACCEPTED:
  title "Owner accepted normalized psyche and separated-call contract"

milestone PSYCHE_COST_REDUCED:
  title "Routine private psyche uses accepted low-cost routing"

milestone SEQUENTIAL_SLICE_READY:
  title "Later actor can decide from earlier observable committed facts"

milestone DURABILITY_READY:
  title "Retry, persistence, and SSE boundaries are verified"

milestone NARRATION_API_READY:
  title "Narration is an independent immutable asynchronous job"

milestone EFFECT_CONTRACT_ACCEPTED:
  title "Owner accepted bounded effect scope"

milestone EFFECT_LIFECYCLE_READY:
  title "Action, effect, and system provenance are separately traceable"

milestone DEFERRED_EFFECTS_READY:
  title "Bounded two-combatant delayed and conditional effects are available"

milestone PACING_MEASURED:
  title "Local pacing evidence and candidate policy are recorded"

milestone PACING_POLICY_ACCEPTED:
  title "Owner decided whether to adopt a pacing candidate"

milestone ISSUE_98_LOCALLY_ACCEPTED:
  title "Issue #98 local acceptance complete"

task T_DRAFT_CAUSAL_CONTRACT ISSUE_INTAKE_RECORDED -> CAUSAL_CONTRACT_DRAFTED:
  title "Trace authority, checkpoints, visibility, and prior-plan disposition"
  description "Record a formal turn state machine: prepare, durable bucket commit, observer projection, later decision, later validation, next bucket commit, and terminal finalize. List every LLM-to-persisted-state and winner edge, including narrator recognition continuity and terminal adjudication, and decide whether each is retained outside this slice, server-validated, or removed. Define durable checkpoints, idempotency-key and lease binding, resume after save/result ambiguity, public durable versus ephemeral SSE events, trace ACL/retention, and legacy read behavior. Record an explicit defer, replace, or integration decision for the completed observation plan's OBS-20260807-09 semantic-equivalence axis. Create fixtures for both speed directions, simultaneous bucket, KO, invalid proposal, timeout, save-success/response-failure, reconnect, and private-intent non-leakage."
  duration 3p
  status done
  owner "codex"
  requires:
    DEV 1

task T_ACCEPT_CAUSAL_CONTRACT CAUSAL_CONTRACT_DRAFTED -> CAUSAL_CONTRACT_ACCEPTED:
  title "Accept the bounded sequential-decision contract"
  description "Owner decides the Phase 1 action source for each bucket, semantic/world visibility timing, retained LLM authority edges, old-plan OBS-09 disposition, and the no-random-initiative/no-new-wait-semantics scope. No code, deployment, release, or Issue mutation is authorized by this decision."
  duration 1p
  status done
  owner "user"
  requires:
    OWNER 1

task T_REFACTOR_BUCKET_EXECUTION CAUSAL_CONTRACT_ACCEPTED -> BUCKET_ENGINE_READY:
  title "Refactor deterministic engine into restartable bucket execution"
  description "Extract pure prepare, resolve-bucket, and finalize operations from the current monolithic resolveTurn path. Implement ADR-0001: ordinary actions always use sequential buckets; equal initiative reuses the previous resolved order, or performs one persisted draw with the initiative calculation's A/B weights, defaulting to exact 50/50 when weights are absent. Preserve A/B-swap invariance, server validation, and deterministic stable IDs. Persist the draw basis, sample, and selected order before action calls. Each operation must be re-enterable without redrawing, replaying an already committed bucket, or consuming a planned action twice."
  duration 4p
  status done
  owner "codex"
  requires:
    DEV 1

task T_AUDIT_EARLY_BUCKET_GROUNDWORK BUCKET_ENGINE_READY -> EARLY_GROUNDWORK_AUDITED:
  title "Audit and integrate prematurely implemented bucket groundwork"
  description "Review commits f22e98c, 2496b54, and bc47793 against the completed bucket-engine contract. Retain only conformant restart continuation, BattleState persistence, retry behavior, administrator checkpoint display, and isolated-side character-agent execution. Add missing focused recovery, privacy, DTO/UI, provider-call-count, and no-committed-bucket-replay tests. Record any remaining durability and sequential-decision obligations in their existing later tasks. This is a new scope item added after T_REFACTOR_BUCKET_EXECUTION started; do not manufacture historical start/finish times or count the groundwork as accepted before this audit finishes."
  duration 1p
  status done
  owner "codex"
  requires:
    DEV 1

task T_COMPLETE_ASSET_GENERATIONS EARLY_GROUNDWORK_AUDITED -> ASSET_GENERATIONS_READY:
  title "Complete durable generations and a minimal normalized battle manifest"
  description "Implement ADR-0003 beyond the baseline. Add append-only generations and current pointers for editable authoritative assets, transactional edit semantics, historical reads, retention identity, and versioned canonical normalization/digests. Replace full CharacterSheet snapshots with a minimal battle-authoritative character generation excluding records, owner memories, revision buffers, and unrelated mutable fields. Bind field preset generation plus concrete derivation, narration style, dialogue settings, rules, psyche contracts, and later narration jobs. Fail closed for new battles; isolate legacy unknowns without reading current rows as historical truth. Test mid-battle edits, retry identity, privacy, legacy reads, and administrator display."
  duration 4p
  owner "codex"
  requires:
    DEV 1

task T_ACCEPT_PIPELINE_LLM_COST_CONTRACT ASSET_GENERATIONS_READY -> LLM_COST_CONTRACT_ACCEPTED:
  title "Accept pipeline-wide LLM cost measurement and routing"
  description "Inventory every battle LLM responsibility and establish a measured baseline for calls, input/output tokens, pricing snapshot, retries, fallback, and p50/p95 latency by phase. Define independent versioned routes for encounter, psyche, action, expression, semantic/world, sensory evidence, narration, and terminal explanation using the order skip or durable reuse, deterministic local processing, fixed lightweight model, then explicitly enumerated high-cost fallback. Set per-responsibility attempt and token ceilings, quality/privacy floors, cost ceilings, receipt fields, and administrator-safe aggregation. Do not merge contexts, allow unbounded repair/escalation, or select models before fixture-based measurement."
  duration 3p
  owner "user"
  requires:
    OWNER 1

task T_ACCEPT_PSYCHE_CALL_CONTRACT LLM_COST_CONTRACT_ACCEPTED -> PSYCHE_CALL_CONTRACT_ACCEPTED:
  title "Accept the adoptable psyche V1 and low-cost call-routing contract"
  description "Specify and owner-accept only the adoptable slice: a small V1 tag/state/trait set derived from committed observer-safe evidence; canonical structural normalization; battle-local neutral relationship defaults; independent least-authority action and expression projections; deterministic no-call and hold routes; an optional fixed lightweight-LLM psyche-only route; explicitly enumerated high-cost fallback; normal-turn call ceilings; cost/token/latency/fallback and quality reject thresholds; provider-failure behavior; and private receipt retention. Neural training, character or experience embeddings, LLM judge, silver/gold pipelines, human-review UI, recurrent state, and long-term relationship learning are outside this contract."
  duration 3p
  owner "user"
  requires:
    OWNER 1

task T_REDUCE_PSYCHE_LLM_COST PSYCHE_CALL_CONTRACT_ACCEPTED -> PSYCHE_COST_REDUCED:
  title "Route routine psyche processing through accepted low-cost paths"
  description "Implement the accepted V1 feature builder, explicit bounded decay/reaction policy, consumer projections, and private reason receipt. Measure deterministic/no-op coverage against the existing deep-psyche path without treating its prose as truth. Where the accepted contract requires semantic compatibility, evaluate one fixed lightweight model with a psyche-only context. Route in the fixed order deterministic/no-call, lightweight LLM, then explicitly allowed high-cost fallback; prohibit runtime escalation outside enumerated cases and keep action/expression calls separate. Accept only if total call, token, and cost fall while fixed privacy, continuity, schema, and downstream regression gates pass."
  duration 4p
  owner "codex"
  requires:
    DEV 1

task T_WIRE_SEQUENTIAL_DECISION PSYCHE_COST_REDUCED -> SEQUENTIAL_SLICE_READY:
  title "Wire observer-safe later-bucket decision and phase receipts"
  description "At turn N finalization, determine and persist turn N+1 initiative/order before requesting the selected first actor reservation; never reserve before order exists. At turn N+1 advance, commit the first bucket, apply immediate server-owned semantic/world facts needed for observation, project only committed observer-visible facts, then independently request, validate, and resolve the later actor action and any deterministically eligible expression. Reuse the audited isolated-side agent foundation without treating its earlier commit as acceptance of this task. Apply the accepted independent action/expression routes and evaluate lightweight models without combining their contexts. Record call counts, token and estimated cost, model route, skip/fallback reason, source-linked expression/action/consequence receipts, and terminal/invalid/timeout outcomes without publishing private prompts."
  duration 5p
  owner "codex"
  requires:
    DEV 1

task T_HARDEN_CAUSAL_DURABILITY SEQUENTIAL_SLICE_READY -> DURABILITY_READY:
  title "Verify checkpoint recovery, idempotency, and public stream ordering"
  description "Complete—not merely retain—the audited checkpoint groundwork. Bind request idempotency, battle lease/version, committed bucket receipt, and final response transactionally or with an explicit recoverable outbox. A retry returns the durable committed result rather than rerunning LLM work. Hold the frontend idempotency key across reconnect retries. Emit new public causal bucket events only after their durable commit; keep progress and private trace out of public SSE replay. Persist privacy-safe responsibility, route, model/prompt generation, token, estimated cost, latency, attempt, reuse, and fallback receipts, and aggregate them in administrator observations alongside causal checkpoints. Legacy records remain unavailable rather than inferred. Test disconnect/reconnect, save succeeds but response completion fails, later LLM timeout after first commit, stale concurrent advance, duplicate-call prevention, and observability DTO/UI compatibility."
  duration 3p
  owner "codex"
  requires:
    DEV 1

task T_SEPARATE_ADVANCE_NARRATION DURABILITY_READY -> NARRATION_API_READY:
  title "Separate gameplay advance from immutable narration jobs"
  description "Implement ADR-0002. Advance commits decisions, mechanics, semantic/world state, terminal outcome, and a turn receipt, then creates or reuses one narration job and returns its ID without awaiting narration. Persist immutable job input bound to the battle asset manifest. Add authorized narration read and SSE stream APIs whose reconnect never reinvokes the provider; order UI placeholders by turn rather than completion. Evaluate an accepted lightweight narrator route against responsibility-specific fixtures and permit a high-cost narrator only for enumerated classes such as an accepted finale route. Remove narrator writes to canonical battle state and make deterministic terminal outcome authoritative. Test pending/failed narration with later advance, out-of-order completion, provider idempotency, snapshot isolation, cost ceilings, and no unbounded escalation."
  duration 4p
  owner "codex"
  requires:
    DEV 1

task T_ACCEPT_EFFECT_SCOPE NARRATION_API_READY -> EFFECT_CONTRACT_ACCEPTED:
  title "Accept bounded effect provenance and deferred-effect scope"
  description "Owner decides the initial server-defined predicates, due/expiry/cancel semantics, observer visibility, and retention. Scope is restricted to effects on the existing two combatants and existing world entities; reinforcements or new combat participants require a separate participant-lifecycle design and approval."
  duration 1p
  owner "user"
  requires:
    OWNER 1

task T_SEPARATE_ACTION_EFFECTS EFFECT_CONTRACT_ACCEPTED -> EFFECT_LIFECYCLE_READY:
  title "Separate action, effect, world, and system provenance"
  description "Add versioned bounded receipts with tagged provenance: action, scheduled effect, system/rules stage, or environment/world transition. Link new public consequences and deltas to exactly one such receipt while retaining lawful start-turn restoration and other system-origin events. Do not infer causal links from prose. Migrate turn records additively; define replay narrowly as pure pending-effect schedule resolution, not unsupported full semantic or full-turn replay."
  duration 4p
  owner "codex"
  requires:
    DEV 1

task T_IMPLEMENT_DEFERRED_EFFECTS EFFECT_LIFECYCLE_READY -> DEFERRED_EFFECTS_READY:
  title "Implement bounded delayed and conditional effects"
  description "Implement stable pending-effect IDs, due-turn or owner-approved server-defined predicates, cancellation/expiry, deterministic schedule resolution, and observer-safe projection at the accepted pre-action boundary. Cover one delayed-hit equivalent and one conditional effect fixture. Do not add arbitrary scripts, unbounded timers, narrator-controlled state changes, or new combat participants."
  duration 3p
  owner "codex"
  requires:
    DEV 1

task T_MEASURE_LOCAL_PACING DEFERRED_EFFECTS_READY -> PACING_MEASURED:
  title "Measure local pacing and prepare a policy candidate"
  description "Version and persist turn-limit, finisher-unlock, decisive-pressure, warning, and terminal-adjudication policy together. Compare the current policy with a local candidate at no more than 12 turns using mean/median completion turn, limit-hit and forced-terminal classification, KO rate, per-turn committed change, repeated action/speech, initiative distribution, and delayed-effect resolution. Record sample size and variance; do not deploy or claim production evidence."
  duration 2p
  owner "codex"
  requires:
    DEV 1

task T_ACCEPT_PACING_POLICY PACING_MEASURED -> PACING_POLICY_ACCEPTED:
  title "Decide whether to adopt a measured pacing candidate"
  description "Owner decides retain, revise, or adopt the candidate based on local evidence. The 8-turn average remains a hypothesis, not an acceptance threshold by itself. Production observation, if desired, is a separately approved task."
  duration 1p
  owner "user"
  requires:
    OWNER 1

task T_ACCEPT_ISSUE_98 PACING_POLICY_ACCEPTED -> ISSUE_98_LOCALLY_ACCEPTED:
  title "Accept Issue #98 locally and prepare release-decision evidence"
  description "Run focused shared/backend/frontend fixtures plus full test, typecheck, build, migration, limited schedule replay, checkpoint recovery, A/B swap, equal-initiative prior-order reuse, first-turn weighted and 50/50 draws, retry without redraw, privacy across DTO/SSE/trace/LLM payload, and provider failure tests. Compare the frozen pipeline-wide LLM baseline with the candidate by total battle/turn cost, calls, tokens, retry, fallback, and p50/p95 latency while enforcing each responsibility's quality/privacy floor; reject a candidate whose total cost rises through longer prompts or escalation. Inspect the administrator internal DAG and cost receipts from persisted evidence. Record release success criteria, rollback target, and a separately authorized production-observation protocol, but do not tag, deploy, promote, mutate the Issue, or change production configuration."
  duration 3p
  owner "codex"
  requires:
    DEV 1

