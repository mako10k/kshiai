task T_PREPARE_PROVIDER_ACCOUNTING_RELEASE PROVIDER_ACCOUNTING_STAGE_ACCEPTED -> PROVIDER_ACCOUNTING_RELEASE_CANDIDATE_READY:
  title "Prepare and verify the v0.17.4 release candidate"
  description "Merge the accepted accounting implementation, bump every workspace and lockfile to v0.17.4, record the migration and rollback contract, pass the exact release PR checks, and freeze an annotated immutable tag. Do not stage from any different commit."
  duration 1p
  status active
  priority 100
  requires:
    DEV 1
  owner "codex"

task T_STAGE_PROVIDER_ACCOUNTING_RELEASE PROVIDER_ACCOUNTING_RELEASE_CANDIDATE_READY -> PROVIDER_ACCOUNTING_STAGED:
  title "Stage the exact v0.17.4 artifacts"
  description "Dispatch Stage from the annotated tag with narration_guarded, no dialogue override, and candidate-12-v2. Apply migration 0016, prove provider accounting without an LLM, and retain the exact backend digest, Cloud Run revision, Worker version, authentication, SSE, R2, and Cloud Tasks evidence."
  duration 1p
  priority 100
  requires:
    DEV 1
  owner "codex"

task T_PROMOTE_PROVIDER_ACCOUNTING_RELEASE PROVIDER_ACCOUNTING_STAGED -> PROVIDER_ACCOUNTING_PRODUCTION_DEPLOYED:
  title "Promote the exact v0.17.4 artifacts"
  description "After Stage acceptance, record rollback targets and use the protected Promote workflow to move the exact staged Cloud Run revision and Worker version to 100 percent production traffic. Require production smoke, authentication, error readback, and GitHub Release publication before observation."
  duration 1p
  priority 100
  requires:
    DEV 1
  owner "codex"

gate G_PROVIDER_ACCOUNTING_BEFORE_OBSERVATION PROVIDER_ACCOUNTING_STAGE_ACCEPTED -> PACING_PRODUCTION_OBSERVED:
  reason "Production pacing observation cannot be accepted or resumed until physical provider attempts are durably classified, atomically bounded, and accepted by the LLM-free Stage gate."

gate G_PROVIDER_ACCOUNTING_DEPLOYMENT_BEFORE_OBSERVATION PROVIDER_ACCOUNTING_PRODUCTION_DEPLOYED -> PACING_PRODUCTION_OBSERVED:
  reason "The bounded production observation cannot be accepted until the exact provider-accounting release has passed Stage and protected production promotion."

