# GitHub Issue #98 implementation plan. Local acceptance is not release
# authorization; owner gates decide only the listed product contracts.
project KSHIAI_ISSUE_98_CAUSAL_BATTLE_PIPELINE:
  version 6
  title "Issue #98 causal battle-pipeline renewal"
  description "Replanned from baseline bc47793 while preserving the original active-task estimate and work events. Finish the pure restartable bucket engine, then audit and integrate the already-written continuation persistence, administrator checkpoint display, and isolated-side agent groundwork before proceeding through asset generations and pipeline-wide LLM cost gates. Do not treat groundwork commits as completed downstream tasks. Private psyche, action, expression, adjudication, and narration contexts remain separate; neural training, embedding, LLM judging, and data-review infrastructure remain deferred."
  as_of 2026-08-12
  duration_unit point
  velocity 2880p/1117h
  target_duration 52p
  finish ISSUE_98_LOCALLY_ACCEPTED

resource DEV:
  title "Developer"
  capacity 1

resource OWNER:
  title "Product and release owner"
  capacity 1











milestone DURABILITY_READY:
  title "Retry, persistence, and SSE boundaries are verified"
  state reached

milestone NARRATION_API_READY:
  title "Narration is an independent immutable asynchronous job"

milestone EFFECT_CONTRACT_ACCEPTED:
  title "Owner accepted bounded effect scope"

milestone EFFECT_LIFECYCLE_READY:
  title "Action, effect, and system provenance are separately traceable"

milestone DEFERRED_EFFECTS_READY:
  title "Bounded two-combatant delayed and conditional effects are available"

milestone PACING_MEASURED:
  title "Local pacing evidence and candidate policy are recorded"

milestone PACING_POLICY_ACCEPTED:
  title "Owner decided whether to adopt a pacing candidate"

milestone ISSUE_98_LOCALLY_ACCEPTED:
  title "Issue #98 local acceptance complete"











task T_SEPARATE_ADVANCE_NARRATION DURABILITY_READY -> NARRATION_AUTHORITY_READY:
  title "Close narration authority and freeze phase inputs"
  description "Implement ADR-0006 authority prerequisites: deterministic winner and ordered prologue/combat/judgment/aftermath receipts[]; remove narrator recognition, prose-derived drama, new raw narrator traces and winner feedback from canonical BattleState; freeze observer-safe input per receipt; add narration-only ordered continuity and a feature-gated legacy presentation read model for battle GET/log/history/improvement. Stop new private prompt/provider payload persistence and define legacy trace retention/access. Test phase cardinality, battle revision CAS, immutable generations/digests, later advance independence, sanitized administrator DTO, legacy dual-read and rollback."
  duration 3p
  owner "codex"
  requires:
    DEV 1

task T_ACCEPT_EFFECT_SCOPE NARRATION_API_READY -> EFFECT_CONTRACT_ACCEPTED:
  title "Accept bounded effect provenance and deferred-effect scope"
  description "Owner decides the initial server-defined predicates, due/expiry/cancel semantics, observer visibility, and retention. Scope is restricted to effects on the existing two combatants and existing world entities; reinforcements or new combat participants require a separate participant-lifecycle design and approval."
  duration 1p
  owner "user"
  requires:
    OWNER 1

task T_SEPARATE_ACTION_EFFECTS EFFECT_CONTRACT_ACCEPTED -> EFFECT_LIFECYCLE_READY:
  title "Separate action, effect, world, and system provenance"
  description "Add versioned bounded receipts with tagged provenance: action, scheduled effect, system/rules stage, or environment/world transition. Link new public consequences and deltas to exactly one such receipt while retaining lawful start-turn restoration and other system-origin events. Do not infer causal links from prose. Migrate turn records additively; define replay narrowly as pure pending-effect schedule resolution, not unsupported full semantic or full-turn replay."
  duration 4p
  owner "codex"
  requires:
    DEV 1

task T_IMPLEMENT_DEFERRED_EFFECTS EFFECT_LIFECYCLE_READY -> DEFERRED_EFFECTS_READY:
  title "Implement bounded delayed and conditional effects"
  description "Implement stable pending-effect IDs, due-turn or owner-approved server-defined predicates, cancellation/expiry, deterministic schedule resolution, and observer-safe projection at the accepted pre-action boundary. Cover one delayed-hit equivalent and one conditional effect fixture. Do not add arbitrary scripts, unbounded timers, narrator-controlled state changes, or new combat participants."
  duration 3p
  owner "codex"
  requires:
    DEV 1

task T_MEASURE_LOCAL_PACING DEFERRED_EFFECTS_READY -> PACING_MEASURED:
  title "Measure local pacing and prepare a policy candidate"
  description "Version and persist turn-limit, finisher-unlock, decisive-pressure, warning, and terminal-adjudication policy together. Compare the current policy with a local candidate at no more than 12 turns using mean/median completion turn, limit-hit and forced-terminal classification, KO rate, per-turn committed change, repeated action/speech, initiative distribution, and delayed-effect resolution. Record sample size and variance; do not deploy or claim production evidence."
  duration 2p
  owner "codex"
  requires:
    DEV 1

task T_ACCEPT_PACING_POLICY PACING_MEASURED -> PACING_POLICY_ACCEPTED:
  title "Decide whether to adopt a measured pacing candidate"
  description "Owner decides retain, revise, or adopt the candidate based on local evidence. The 8-turn average remains a hypothesis, not an acceptance threshold by itself. Production observation, if desired, is a separately approved task."
  duration 1p
  owner "user"
  requires:
    OWNER 1

task T_ACCEPT_ISSUE_98 PACING_POLICY_ACCEPTED -> ISSUE_98_LOCALLY_ACCEPTED:
  title "Accept Issue #98 locally and prepare release-decision evidence"
  description "Run focused shared/backend/frontend fixtures plus full test, typecheck, build, migration, limited schedule replay, checkpoint recovery, A/B swap, equal-initiative prior-order reuse, first-turn weighted and 50/50 draws, retry without redraw, privacy across DTO/SSE/trace/LLM payload, and provider failure tests. Compare the frozen pipeline-wide LLM baseline with the candidate by total battle/turn cost, calls, tokens, retry, fallback, and p50/p95 latency while enforcing each responsibility's quality/privacy floor; reject a candidate whose total cost rises through longer prompts or escalation. Inspect the administrator internal DAG and cost receipts from persisted evidence. Record release success criteria, rollback target, and a separately authorized production-observation protocol, but do not tag, deploy, promote, mutate the Issue, or change production configuration."
  duration 3p
  owner "codex"
  requires:
    DEV 1

milestone NARRATION_AUTHORITY_READY:
  title "Canonical narration authority and immutable inputs are separated"

milestone NARRATION_CONTRACT_ACCEPTED:
  title "Owner accepted narration runtime, cost, audience, and retention contract"

milestone NARRATION_WORKER_READY:
  title "Ordered fenced narration worker is locally verified"

milestone NARRATION_STREAM_READY:
  title "Battle narration API and UI migration are locally verified"

task T_ACCEPT_NARRATION_CONTRACT NARRATION_AUTHORITY_READY -> NARRATION_CONTRACT_ACCEPTED:
  title "Accept narration infrastructure and delivery contract"
  description "Owner accepts or revises the deterministic terminal rule, recognition-continuity disposition, authenticated queue-push infrastructure and recovery operation, terminal-only public prose, lightweight model route with total adapter-plus-worker attempt/token/cost ceiling, audience/realm policy, public-event and internal-attempt retention, reset high-watermark policy, and legacy trace handling. This local design gate does not authorize cloud deployment or production configuration."
  duration 1p
  requires:
    OWNER 1
  owner "user"

task T_BUILD_ORDERED_NARRATION_WORKER NARRATION_CONTRACT_ACCEPTED -> NARRATION_WORKER_READY:
  title "Build fenced ordered narration worker"
  description "Persist unique battleId+turnReceiptId entries, battle-local sequence, terminal-only allowlisted audience events, internal attempt receipts and an independent fenced lease. Use durable outbox plus authenticated queue push for Cloud Run scale-to-zero and recovery scan. Enforce earliest-nonterminal ordering, cross-battle fairness, stale-worker rejection and the accepted total retry/token/cost ceiling. Use the accepted lightweight narrator route and deterministic terminal fallback. Test redelivery, lease loss, worker crash/takeover, failure releasing the successor, no partial prose mixing, backlog, privacy and sanitized admin queue/lease/cost evidence."
  duration 4p
  requires:
    DEV 1
  owner "codex"

task T_BUILD_BATTLE_NARRATION_STREAM NARRATION_WORKER_READY -> NARRATION_STREAM_READY:
  title "Build battle narration API, UI, and compatibility migration"
  description "Add authorized ordered read/per-receipt APIs and finite bearer-authenticated fetch-SSE follow with opaque durable cursor. Provide at-least-once replay, idempotent replacement reducer, atomic retention reset high-watermark, periodic authorization/realm/deletion checks, heartbeat and reconnect across platform timeout. Move frontend to independent advance/narration states, ordered receipt placeholders and held advance idempotency key. Integrate the feature-gated presentation read model with BattlePublic/history/improvement, retain rollback, and expose sanitized administrator queue/blocking/cost/retention lane. Test N+1 waiting without blocking advance, no provider call on connect, token refresh, pruned cursor, audience isolation, legacy dual-read and physical reconnect."
  duration 5p
  requires:
    DEV 1
  owner "codex"

task T_ACCEPT_NARRATION_MIGRATION NARRATION_STREAM_READY -> NARRATION_MIGRATION_ACCEPTED:
  title "Accept narration compatibility cutover"
  description "Owner reviews local migration fixtures, queue/lease/cost/admin evidence, legacy dual-read and rollback. Acceptance authorizes the following local cleanup task to remove narrator progress from advance SSE and default the composite presentation read model. It does not authorize cloud queue creation, deployment, production data migration, release, or production observation."
  duration 1p
  requires:
    OWNER 1
  owner "user"

milestone NARRATION_MIGRATION_ACCEPTED:
  title "Owner accepted the local narration compatibility cutover"

task T_CUTOVER_NARRATION_COMPATIBILITY NARRATION_MIGRATION_ACCEPTED -> NARRATION_API_READY:
  title "Cut over local narration compatibility surfaces"
  description "After owner acceptance, remove non-durable narrator progress from advance SSE, default the feature-gated composite presentation read model for local clients, retain the documented rollback switch and rerun API/frontend/history/improvement/admin privacy fixtures. Do not deploy, create cloud queue infrastructure, migrate production data, release, or observe production."
  duration 1p
  requires:
    DEV 1
  owner "codex"
