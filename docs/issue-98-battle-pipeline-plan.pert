# GitHub Issue #98 implementation plan. Local acceptance is not release
# authorization; owner gates decide only the listed product contracts.
project KSHIAI_ISSUE_98_CAUSAL_BATTLE_PIPELINE:
  version 6
  title "Issue #98 causal battle-pipeline renewal"
  description "Replanned from baseline bc47793 while preserving the original active-task estimate and work events. Finish the pure restartable bucket engine, then audit and integrate the already-written continuation persistence, administrator checkpoint display, and isolated-side agent groundwork before proceeding through asset generations and pipeline-wide LLM cost gates. Do not treat groundwork commits as completed downstream tasks. Private psyche, action, expression, adjudication, and narration contexts remain separate; neural training, embedding, LLM judging, and data-review infrastructure remain deferred."
  as_of 2026-08-12
  duration_unit point
  velocity 2880p/1117h
  target_duration 56p
  finish ISSUE_98_LOCALLY_ACCEPTED

resource DEV:
  title "Developer"
  capacity 1

resource OWNER:
  title "Product and release owner"
  capacity 1















milestone DEFERRED_EFFECTS_READY:
  title "Bounded two-combatant delayed and conditional effects are available"
  state reached

milestone PACING_MEASURED:
  title "Local pacing evidence and candidate policy are recorded"

milestone PACING_POLICY_ACCEPTED:
  title "Owner decided whether to adopt a pacing candidate"

milestone ISSUE_98_LOCALLY_ACCEPTED:
  title "Issue #98 local acceptance complete"















task T_MEASURE_LOCAL_PACING DEFERRED_EFFECTS_READY -> PACING_MEASURED:
  title "Measure local pacing and prepare a policy candidate"
  description "Version and persist turn-limit, finisher-unlock, decisive-pressure, warning, and terminal-adjudication policy together. Compare the current policy with a local candidate at no more than 12 turns using mean/median completion turn, limit-hit and forced-terminal classification, KO rate, per-turn committed change, repeated action/speech, initiative distribution, and delayed-effect resolution. Record sample size and variance; do not deploy or claim production evidence."
  duration 2p
  status done
  owner "codex"
  requires:
    DEV 1

task T_ACCEPT_PACING_POLICY PACING_MEASURED -> PACING_POLICY_ACCEPTED:
  title "Decide whether to adopt a measured pacing candidate"
  description "Owner decides retain, revise, or adopt the candidate based on local evidence. The 8-turn average remains a hypothesis, not an acceptance threshold by itself. Production observation, if desired, is a separately approved task."
  duration 1p
  owner "user"
  requires:
    OWNER 1

task T_ACCEPT_ISSUE_98 PACING_POLICY_ACCEPTED -> ISSUE_98_LOCALLY_ACCEPTED:
  title "Accept Issue #98 locally and prepare release-decision evidence"
  description "Run focused shared/backend/frontend fixtures plus full test, typecheck, build, migration, limited schedule replay, checkpoint recovery, A/B swap, equal-initiative prior-order reuse, first-turn weighted and 50/50 draws, retry without redraw, privacy across DTO/SSE/trace/LLM payload, and provider failure tests. Compare the frozen pipeline-wide LLM baseline with the candidate by total battle/turn cost, calls, tokens, retry, fallback, and p50/p95 latency while enforcing each responsibility's quality/privacy floor; reject a candidate whose total cost rises through longer prompts or escalation. Inspect the administrator internal DAG and cost receipts from persisted evidence. Record release success criteria, rollback target, and a separately authorized production-observation protocol, but do not tag, deploy, promote, mutate the Issue, or change production configuration."
  duration 3p
  owner "codex"
  requires:
    DEV 1

