# GitHub Issue #98 implementation plan. Local acceptance is not release
# authorization; owner gates decide only the listed product contracts.
project KSHIAI_ISSUE_98_CAUSAL_BATTLE_PIPELINE:
  version 6
  title "Issue #98 causal battle-pipeline renewal"
  description "Replanned from baseline bc47793 while preserving the original active-task estimate and work events. Finish the pure restartable bucket engine, then audit and integrate the already-written continuation persistence, administrator checkpoint display, and isolated-side agent groundwork before proceeding through asset generations and pipeline-wide LLM cost gates. Do not treat groundwork commits as completed downstream tasks. Private psyche, action, expression, adjudication, and narration contexts remain separate; neural training, embedding, LLM judging, and data-review infrastructure remain deferred."
  as_of 2026-08-12
  duration_unit point
  velocity 2880p/1117h
  target_duration 56p
  finish ISSUE_98_LOCALLY_ACCEPTED

resource DEV:
  title "Developer"
  capacity 1

resource OWNER:
  title "Product and release owner"
  capacity 1
















milestone PACING_MEASURED:
  title "Local pacing evidence and candidate policy are recorded"
  state reached

milestone PACING_POLICY_ACCEPTED:
  title "Owner decided whether to adopt a pacing candidate"

milestone ISSUE_98_LOCALLY_ACCEPTED:
  title "Issue #98 local acceptance complete"
















task T_ACCEPT_PACING_POLICY PACING_E2E_OBSERVED -> PACING_POLICY_ACCEPTED:
  title "Decide whether to adopt a measured pacing candidate"
  description "Owner decides retain, revise, or adopt the candidate using validated synthetic evidence plus the bounded real-pipeline observation. The Issue hypotheses of about eight average turns and no more than twelve are assessed with uncertainty and quality tradeoffs; neither is rejected from synthetic evidence alone. Production observation remains separately authorized."
  duration 1p
  owner "user"
  requires:
    OWNER 1

task T_ACCEPT_ISSUE_98 PACING_POLICY_ACCEPTED -> ISSUE_98_LOCALLY_ACCEPTED:
  title "Accept Issue #98 locally and prepare release-decision evidence"
  description "Run focused shared/backend/frontend fixtures plus full test, typecheck, build, migration, limited schedule replay, checkpoint recovery, A/B swap, equal-initiative prior-order reuse, first-turn weighted and 50/50 draws, retry without redraw, privacy across DTO/SSE/trace/LLM payload, and provider failure tests. Compare the frozen pipeline-wide LLM baseline with the candidate by total battle/turn cost, calls, tokens, retry, fallback, and p50/p95 latency while enforcing each responsibility's quality/privacy floor; reject a candidate whose total cost rises through longer prompts or escalation. Inspect the administrator internal DAG and cost receipts from persisted evidence. Record release success criteria, rollback target, and a separately authorized production-observation protocol, but do not tag, deploy, promote, mutate the Issue, or change production configuration."
  duration 3p
  owner "codex"
  requires:
    DEV 1

milestone PACING_HARNESS_VALIDATED:
  title "Pacing evidence method is validated"

milestone PACING_CANDIDATE_TUNED:
  title "A measured pacing candidate meets the exploration criteria"

milestone PACING_LLM_TRIAL_AUTHORIZED:
  title "Owner authorized a bounded real-LLM pacing trial"

milestone PACING_E2E_OBSERVED:
  title "Bounded end-to-end pacing evidence is recorded"

task T_VALIDATE_PACING_EVIDENCE PACING_MEASURED -> PACING_HARNESS_VALIDATED:
  title "Validate the pacing evidence method"
  description "Treat the existing deterministic harness only as candidate-search evidence. Compare its predictions with existing persisted battle records and representative engine/application fixtures; cover attack, defend, recovery, finisher, initiative, interruption, and delayed effects; run multiple seeds and sensitivity checks; quantify mismatch and confidence limits. Do not reject or accept the Issue hypothesis from synthetic evidence alone and do not call a real LLM."
  duration 3p
  requires:
    DEV 1
  owner "codex"

task T_TUNE_PACING_POLICY PACING_HARNESS_VALIDATED -> PACING_CANDIDATE_TUNED:
  title "Tune a credible pacing candidate"
  description "Using only the validated portions of the evidence method, tune coupled damage, defense, recovery, finisher timing and power, decisive pressure, and maximum turn parameters toward the Issue hypothesis of about eight average turns and no more than twelve. Compare multiple candidates, report distributions and forced-terminal tradeoffs, retain current behavior as rollback, and do not claim real-play validity."
  duration 3p
  requires:
    DEV 1
  owner "codex"

task T_ACCEPT_BOUNDED_LLM_PACING_TRIAL PACING_CANDIDATE_TUNED -> PACING_LLM_TRIAL_AUTHORIZED:
  title "Authorize a bounded real-LLM pacing trial"
  description "Owner reviews the tuned candidate, fixture limitations, exact non-production sample size, provider/model, maximum calls, tokens, retries, and cost before any real LLM call. Approval authorizes only that bounded local trial, not deployment or policy adoption."
  duration 1p
  requires:
    OWNER 1
  owner "user"

task T_OBSERVE_BOUNDED_LLM_PACING PACING_LLM_TRIAL_AUTHORIZED -> PACING_E2E_OBSERVED:
  title "Observe pacing through the real battle pipeline"
  description "Run only the owner-approved non-production real-LLM sample through the actual advance pipeline. Record completion distribution, forced terminals, per-turn state change, repeated action and speech, initiative response, delayed-effect behavior, total calls, tokens, retries, latency, and cost. Compare against a frozen baseline and preserve failed or inconclusive evidence without expanding the authorized budget."
  duration 3p
  requires:
    DEV 1
  owner "codex"
