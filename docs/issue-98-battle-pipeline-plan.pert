# GitHub Issue #98 implementation plan. Local acceptance is not release
# authorization; owner gates decide only the listed product contracts.
project KSHIAI_ISSUE_98_CAUSAL_BATTLE_PIPELINE:
  version 6
  title "Issue #98 causal battle-pipeline renewal"
  description "Replanned from baseline bc47793 while preserving completed work and observation history. The v0.17.3 functional observation exposed an acceptance failure in provider-operation accounting, so add a new critical-path slice for an accepted accounting ADR, terminal attempt read correctness and exhaustive operation taxonomy, a durable physical-attempt ledger with atomic reservation, and an LLM-free Stage acceptance gate before production observation may resume. The owner has now authorized the exact v0.17.4 release, staged promotion, production deployment, and one bounded observation; private psyche, action, expression, adjudication, and narration contexts remain separate."
  as_of 2026-08-13
  duration_unit point
  velocity 2880p/1117h
  target_duration 71p
  finish ISSUE_98_LOCALLY_ACCEPTED

resource DEV:
  title "Developer"
  capacity 1

resource OWNER:
  title "Product and release owner"
  capacity 1

















milestone PACING_POLICY_ACCEPTED:
  title "Owner decided whether to adopt a pacing candidate"

milestone ISSUE_98_LOCALLY_ACCEPTED:
  title "Issue #98 local acceptance complete"
















task T_ACCEPT_PACING_POLICY PACING_PRODUCTION_OBSERVED -> PACING_POLICY_ACCEPTED:
  title "Decide whether to adopt a measured pacing candidate"
  description "Owner periodically decides keep, revise, or roll back the provisional policy using accumulated production evidence. There is no requirement to finalize the numeric values after one observation window; each adjustment remains versioned and existing battles retain their frozen policy."
  duration 1p
  owner "user"
  requires:
    OWNER 1

task T_ACCEPT_ISSUE_98 PACING_POLICY_ACCEPTED -> ISSUE_98_LOCALLY_ACCEPTED:
  title "Accept Issue #98 locally and prepare release-decision evidence"
  description "Run focused shared/backend/frontend fixtures plus full test, typecheck, build, migration, limited schedule replay, checkpoint recovery, A/B swap, equal-initiative prior-order reuse, first-turn weighted and 50/50 draws, retry without redraw, privacy across DTO/SSE/trace/LLM payload, and provider failure tests. Compare the frozen pipeline-wide LLM baseline with the candidate by total battle/turn cost, calls, tokens, retry, fallback, and p50/p95 latency while enforcing each responsibility's quality/privacy floor; reject a candidate whose total cost rises through longer prompts or escalation. Inspect the administrator internal DAG and cost receipts from persisted evidence. Record release success criteria, rollback target, and a separately authorized production-observation protocol, but do not tag, deploy, promote, mutate the Issue, or change production configuration."
  duration 3p
  owner "codex"
  requires:
    DEV 1











task T_OBSERVE_PRODUCTION_PACING PACING_PRODUCTION_DEPLOYED -> PACING_PRODUCTION_OBSERVED:
  title "Observe the bounded production pacing trial"
  description "After an initial safety readback, accumulate ordinary production battle evidence over time: completion distribution, maximum-turn and forced-terminal rate, KO and one-shot rate, committed change, action and speech repetition, initiative response, delayed effects, errors, latency, calls, tokens, retries, and cost. Compare periodic snapshots with the frozen pre-deploy baseline and make small versioned policy revisions; do not imply that the provisional values are final."
  duration 3p
  status suspended
  requires:
    DEV 1
  owner "codex"



milestone PACING_PRODUCTION_DEPLOYED:
  title "Pacing candidate is deployed to production"
  state reached

milestone PACING_PRODUCTION_OBSERVED:
  title "Bounded production pacing evidence is recorded"

task T_REPAIR_OBSERVATION_PIPELINE PACING_PRODUCTION_DEPLOYED -> PACING_PRODUCTION_OBSERVED:
  title "Repair production observation pipeline after RCA"
  description "Preserve turn-start receipts; recover exhausted narration delivery generations; fence battle checkpoints; make battle create replayable; expose outbox state; prove staged Cloud Tasks OIDC delivery without an LLM."
  duration 5p
  status done
  requires:
    DEV 1
  owner "codex"

task T_ROUTE_REFEREE_FAST_AND_CORRECT_RCA PACING_PRODUCTION_DEPLOYED -> PACING_PRODUCTION_OBSERVED:
  title "Route referee through fast tier and correct RCA"
  description "Change the turn-limit referee provider route from engine to fast while preserving deterministic winner authority and context separation. Add a focused non-provider regression test for the tier selection. Correct the production RCA to count the encounter preparation and referee calls, record at least 48 application-level operations, distinguish the one historical engine-tier referee from the four fast environment proposals, and recommend fast or deterministic explanation. Validate the RCA and focused/full static gates without invoking an LLM. Do not resume the queue, deploy, or run another observation."
  duration 1p
  status done
  requires:
    DEV 1
  owner "codex"


task T_RCA_EXACT_RECEIPT_LIFECYCLE RCA_HISTORY_SAFE -> RCA_NARRATION_LIFECYCLE_SAFE:
  title "Implement exact-receipt narration lifecycle"
  description "Implement FIX1 and FIX2: bind task execution to battleId, receiptId, outboxId, and deliveryGeneration; claim only that receipt; use unique fenced ownership; terminally acknowledge stale or completed generations; avoid 503 as normal ordering; replace age-only global recovery with explicit generation eligibility and singleton or transactionally claimed recovery. Prove duplicate wakes cannot duplicate provider work using stubs only."
  duration 4p
  status done
  requires:
    DEV 1
  owner "codex"

task T_RCA_SSE_UI_SEQUENCE RCA_NARRATION_LIFECYCLE_SAFE -> RCA_PRESENTATION_SAFE:
  title "Implement bounded SSE and ordered battle presentation"
  description "Implement FIX3 and FIX4: bounded follow waits for durable events or heartbeat, frontend consumes the stream incrementally with cursor and refreshed credentials, one reducer orders terminal and pending receipts, legacy advance narration state is removed, and canonical versus narrated-through progress is labelled explicitly. Add reconnect, duplicate-event, ordering, and active-finished UI fixtures."
  duration 4p
  status done
  requires:
    DEV 1
  owner "codex"

task T_RCA_COST_RELEASE_GUARDS RCA_PRESENTATION_SAFE -> RCA_OBSERVATION_GUARDED:
  title "Close observation cost telemetry and release acceptance"
  description "Implement FIX6 and FIX7: replace smoke-only acceptance with an LLM-free exact-receipt lifecycle fixture; require terminal receipt convergence, one provider attempt per receipt, history visibility, ordered projection, and no live generations; add observation-wide projected and actual provider-operation ceilings by layer with an operator pause. Preserve responsibility separation and do not resume production observation."
  duration 4p
  status done
  requires:
    DEV 1
  owner "codex"

task T_ACCEPT_PROVIDER_ACCOUNTING_ADR PACING_PRODUCTION_DEPLOYED -> PROVIDER_ACCOUNTING_CONTRACT_ACCEPTED:
  title "Accept the provider operation accounting contract"
  description "Record ADR-0007 from the audited v0.17.3 LLMTHINK RCA. Fix ownership, correlation, physical-attempt identity, atomic reservation, privacy, retention, migration and acceptance boundaries before implementation. The accepted direction does not authorize deployment, release or another production observation."
  duration 2p
  status done
  priority 100
  requires:
    DEV 1
  owner "codex"

task T_FIX_PROVIDER_ACCOUNTING_READ_MODEL PROVIDER_ACCOUNTING_CONTRACT_ACCEPTED -> PROVIDER_ACCOUNTING_READ_SAFE:
  title "Correct retained attempts and operation projection"
  description "Separate active narration ownership from retained latest-attempt display; aggregate all attempts including abandoned and failed rows; define an exhaustive revisioned layer taxonomy; and derive a conservative phase-aware projection that includes battlefield concretization, encounter preparation, deep psyche, expression, environment, narration and referee operations. Prove the slice with provider stubs only."
  duration 2p
  status done
  priority 100
  requires:
    DEV 1
  owner "codex"

task T_IMPLEMENT_PROVIDER_ATTEMPT_LEDGER PROVIDER_ACCOUNTING_READ_SAFE -> PROVIDER_ACCOUNTING_ENFORCED:
  title "Implement the provider attempt ledger and reservation ceiling"
  description "At the common provider transport boundary, bind observation run, battle, logical call, layer, operation, model tier and attempt ordinal; atomically reserve each physical outbound attempt before the call; durably record outcome and available usage without prompts or private state; count failed attempts; reject unbound or unclassified observation calls; and preserve unknown token or cost values as unknown."
  duration 5p
  status done
  priority 100
  requires:
    DEV 1
  owner "codex"

task T_VERIFY_PROVIDER_ACCOUNTING_GATES PROVIDER_ACCOUNTING_ENFORCED -> PROVIDER_ACCOUNTING_STAGE_ACCEPTED:
  title "Verify provider accounting and observation acceptance"
  description "Use an injected fake transport to prove success, retry, failure, idempotent reservation and fail-closed exhaustion. Require exact run and battle binding, complete classification, terminal logical calls and narration receipts, ledger totals equal by-layer sums, receipt-ledger agreement and no unknown usage represented as zero. Pass focused and full local gates plus the LLM-free Stage fixture; do not deploy or observe production."
  duration 3p
  status done
  priority 100
  requires:
    DEV 1
  owner "codex"

