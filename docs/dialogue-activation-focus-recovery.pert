# Scoped recovery plan for effective compact-dialogue activation and the
# character-focus experiment. It contains no production promotion task.
project KSHIAI_DIALOGUE_ACTIVATION_FOCUS_RECOVERY:
  version 6
  title "Recover dialogue activation authority before focus wiring"
  description "Establish the effective compact-dialogue configuration owner, preserve the accepted immutable activation contract and completed local wiring, deploy one separately authorized no-traffic Stage candidate, observe one bounded battle, and choose the next smallest step from that result. Preserve existing battles, mechanics, provider counts, privacy, release gates, and the production boundary; do not precommit later observations or speculative controls."
  as_of 2026-09-04
  duration_unit point
  velocity 1p/1d
  target_duration 12p
  finish REPAIRED_STAGE_OBSERVED
  goal_owner user
  dag_owner user

resource DEV:
  title "Developer"
  capacity 1

resource OWNER:
  title "Product and release owner"
  capacity 1

milestone NOW:
  title "Recovery tasks registered and handed off"
  state reached

milestone AUTHORITY_AUDITED:
  title "Effective dialogue mode authority and historical drift audited"
  state reached

milestone ACTIVATION_ADR_ACCEPTED:
  title "Dialogue activation authority explicitly accepted"

milestone LOCAL_WIRING_READY:
  title "Immutable compact-dialogue activation wiring passes local gates"




milestone STAGE_OBSERVED:
  title "First bounded compact-dialogue Stage outcome retained"
  description "One exactly identified no-traffic Stage candidate has produced one retained success, failure, or stopped outcome; this milestone alone does not authorize another battle, Promote, or production activation."

milestone RECOVERY_PLAN_COMPLETED:
  title "Persistent E2E character readiness recovered locally"
  description "The retained fixture repair passes local regression, type, and build gates. Shared Stage fixtures and deployed revisions remain unchanged until separately authorized."

task DAF_AUDIT NOW -> AUTHORITY_AUDITED:
  title "Audit effective dialogue mode ownership and plan drift"
  description "Read current code, persisted settings metadata, deployment variable selection, immutable battle snapshots, retained traces, release records, and the DCL plan without mutating runtime state. Produce a LLMTHINK RCA and an exact precedence table for default, administrator setting, revision-local override, and battle binding. Record only enum choices, revisions, artifact identities, digests, and source references; never read or retain secret values. Use sealgraph only as a disposable reconstruction from the LLMTHINK original. Reconcile achieved DCL implementation separately from unmet activation and observation scope."
  duration 1p
  status done
  requires:
    DEV 1
  owner "codex"
  source "docs/evidence/dialogue-activation-authority-audit-2026-09-03.md"

task DAF_ACCEPT_ACTIVATION_ADR AUTHORITY_AUDITED -> ACTIVATION_ADR_ACCEPTED:
  title "Accept or revise ADR-0018 dialogue activation authority"
  description "Review the exact Proposed LLMTHINK ADR-0018 draft, allocated from verified current main at 4d446e4, and decide the normal authority, the narrowly staged override boundary, immutable mode source and revision receipts, compatibility, rollback, and non-goals. Recheck the ADR namespace and reconcile the branch's divergent ADR-0015 before integration. Generic continuation does not accept the ADR. Rejection or revision is valid and authorizes no wiring."
  duration 1p
  status done
  requires:
    OWNER 1
  owner "user"
  source "docs/adr/0018-dialogue-context-activation-authority.think"

task DAF_WIRE_COMPACT_LOCAL ACTIVATION_ADR_ACCEPTED -> LOCAL_WIRING_READY:
  title "Wire compact dialogue activation into new immutable battle snapshots"
  description "Implement only the accepted authority contract. Bind new battles to the effective projection mode, source, settings revision, and content identity; do not reread mutable settings during a battle or migrate existing battles. Preserve action, mechanics, world, rating, narration authority, provider call count, retries, and public privacy. Add precedence, direct-create, legacy, missing-setting, rollback, and no-ordinary-path-drift tests. Pass full local gates and record the exact candidate SHA. Do not deploy."
  duration 3p
  status done
  requires:
    DEV 1
  owner "codex"
  source "git:4133445b2f144187c955f4487c209d02d895bedb"





task DAF_REPLAN_FOCUS STAGE_OBSERVED -> E2E_FIXTURE_READINESS_REPAIR_SELECTED:
  title "Assess the first Stage outcome and select the next smallest task"
  description "Read the retained DAF_STAGE_SMOKE_1 outcome before adding work. If deployment, activation binding, schema, provider behavior, or dialogue observation failed, register only the smallest repair or discriminating recheck supported by that evidence. If the observation is sufficient, reconcile docs/character-focus-hypothesis.pert with the replay RCA and define the next causal experiment slice. Do not schedule more Stage battles in advance, treat a stopped or failed smoke as success, implement speculative controls, wire focus into product expression, call a provider, deploy, or reopen production during this task."
  duration 2p
  status done
  requires:
    DEV 1
  owner "codex"
  source "docs/evidence/dialogue-activation-stage-smoke-2026-09-04.md"

task DAF_STAGE_SMOKE_1 LOCAL_WIRING_READY -> STAGE_OBSERVED:
  title "Deploy and inspect one compact-dialogue Stage battle"
  description "Use the exact local candidate and perform only the cheap preflight needed to identify its current-main integration path, release eligibility, pending-migration effect, no-traffic Stage target, rollback identity, Stage observer route, and retained fixture. Before each external effect, obtain its exact authorization. Deploy one digest-qualified no-traffic Stage revision with the compact override and execute at most one existing-fixture battle with at most 24 advances. Reuse the ADR-0007 ceiling of 169 physical provider attempts per battle; do not implement ADR-0019 token or USD reservation, a durable budget schema, or a six-run controller. Retain the effective mode, source, deployment identity, provider attempts, advances, reported tokens, elapsed time, retries, fallback and loop outcome. Any failed preflight, deployment failure, provider or schema failure, stop condition, or completed battle ends this slice without automatic retry or replacement. Do not Promote, alter production traffic or settings, or run a second battle."
  duration 2p
  status done
  requires:
    DEV 1
  owner "codex"
  source "docs/adr/0018-dialogue-context-activation-authority.think; docs/evidence/dialogue-activation-stage-smoke-2026-09-04.md"

task DAF_REPAIR_E2E_FIXTURE_READINESS E2E_FIXTURE_READINESS_REPAIR_SELECTED -> RECOVERY_PLAN_COMPLETED:
  title "Repair retained E2E character fixture readiness"
  description "Make the exact persistent observer character fixtures readiness-aware. Reuse a correctly owned, non-deleted fixture only when its current immutable V2 generation is ready under the active compiler and envelope contract. Otherwise append and activate a deterministic LLM-free V2 fixture generation while preserving accumulated operational state such as rating records and opponent memories. Keep ready reuse idempotent, keep listReadyCharacterIds and matchmaking fail closed, and reject ownership or deletion mismatches. Add regression coverage for retained unsupported generations, preserved accumulated state, selector eligibility, and a no-write second ensure. This task is local only: do not mutate shared Stage fixtures, call a provider, deploy, rerun the observer, or change production."
  duration 1p
  status done
  requires:
    DEV 1
  owner "codex"
  source "docs/evidence/dialogue-activation-stage-smoke-2026-09-04.md; docs/adr/0010-structured-selectable-asset-envelope.md"

task DAF_STAGE_SMOKE_2 RECOVERY_PLAN_COMPLETED -> REPAIRED_STAGE_OBSERVED:
  title "Deploy and inspect one repaired compact-dialogue Stage battle"
  description "Integrate the exact readiness repair through the protected main path, create one annotated release candidate, deploy one digest-qualified no-traffic Stage revision with compact override, and execute at most one retained-fixture battle with at most 24 advances and 169 physical provider attempts. Retain deployment identity, fixture disposition, activation receipt, provider attempts, advances, reported tokens, elapsed time, retries, fallback, dialogue output, and loop outcome. Any failed preflight, CI, deployment, provider, schema, or stop condition ends this slice without retry. Do not Promote, change production traffic or settings, or run a second battle."
  duration 2p
  status done
  requires:
    DEV 1
  owner "codex"
  source "docs/evidence/dialogue-activation-stage-smoke-2-2026-09-04.md"

