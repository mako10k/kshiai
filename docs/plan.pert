task T_CICD RELEASE_RULES_READY -> CICD_READY:
  title "Implement CI validation and controlled cloud deployment"
  description "Add GitHub Actions for build typecheck tests audits container and Worker checks plus protected deployment environments keyless identity immutable promotion smoke tests and rollback"
  duration 2d
  requires:
    DEV 1

