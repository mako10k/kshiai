milestone BATTLE_PIPELINE_ACCEPTED:
  title "Hypothesis-first production battle pipeline accepted"
  description "The most axial and current-main-patchable source projection causal receipt and guarded consumer slice is implemented before trial; residual observation items do not preempt that sequence"

task T_BATTLE_PIPELINE CICD_READY -> BATTLE_PIPELINE_ACCEPTED:
  title "Implement try and accept the axial production battle pipeline slice"
  description "Execute docs/battle-pipeline-production-rollout.pert from current main. First implement actual-turn source authoring and compact projections the proposal-to-result causal receipt and one guarded narration consumer; then run staging and explicitly authorized production trials. Select by hypothesis centrality and current-main patchability rather than by observation backlog order, and do not import the full PoC architecture."
  duration 10d
  requires:
    DEV 1
  owner "codex"
  source "docs/battle-pipeline-production-rollout.pert"
