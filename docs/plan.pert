project KSHIAI:
  version 6
  title "kshiai production pipeline and billing completion"
  description "Continue from the deployed current main. Implement and try the most axial and current-main-patchable battle-pipeline hypotheses through the separate staged plan before completing Stripe billing and entitlements. Preserve the PoC as hypothesis evidence and reduced implementation material; observation backlog items are secondary evaluation lenses rather than the source of implementation priority."
  as_of 2026-08-07
  duration_unit day
  finish BILLING_READY
  goal_owner user
  dag_owner user

resource DEV:
  title "Developer"
  capacity 1

milestone NOW:
  title "Now"
  state reached

