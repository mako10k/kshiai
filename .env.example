# Server
PORT=3088
HOST=127.0.0.1
DATABASE_PATH=./data/kshiai.db
SESSION_SECRET=change-me-in-production
# Comma-separated origins (local + public tunnel)
CORS_ORIGIN=http://127.0.0.1:5188,http://localhost:5188,https://kshiai.mk10.org
# true when serving over HTTPS (Cloudflare Tunnel)
COOKIE_SECURE=true
# Optional outside Cloud Run. When set, /api requests require the matching
# x-kshiai-origin header injected by the Cloudflare frontend Worker.
ORIGIN_SHARED_SECRET=

# Supabase/PostgreSQL migration. Runtime uses the session pooler DATABASE_URL;
# schema/data migration uses the direct DIRECT_URL. Require TLS in application
# connection options even when the copied URL omits sslmode=require.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
AUTH_PROVIDER=legacy
# Operator endpoints fail closed when both lists are empty. Internal application
# user IDs and verified Supabase email addresses are accepted.
ADMIN_USER_IDS=
ADMIN_EMAILS=
# Browser-safe values consumed by the Vite frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
DATABASE_POOL_MAX=10

# Shared generated-image storage. Production requires r2.
MEDIA_STORAGE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public r2.dev or custom-domain origin, without a trailing slash.
R2_PUBLIC_BASE_URL=
DATABASE_SCHEMA=public
DIRECT_URL=
# Optional override; the Supabase 2021 root CA is bundled under infra/.
POSTGRES_CA_CERT_PATH=

# Legacy first provider: mock | xai | openai | venice
# Prefer: secdat unlock && npm run sync:secdat
# secdat keys: XAI_API_KEY, OPENAI_API_KEY, VENICEAI_API_KEY
LLM_PROVIDER=mock
# Ordered fallback. Quota-limited providers are skipped for the cooldown period.
LLM_PROVIDER_ORDER=mock
# Development/test only. Never enables mock when NODE_ENV=production.
ALLOW_MOCK_FALLBACK=false
LLM_QUOTA_COOLDOWN_MS=3600000
IMAGE_PROVIDER_ORDER=xai,venice
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Legacy single model (falls back into MODEL_ENGINE)
XAI_MODEL=grok-4.5
# Engine tier: character / battlefield / policies / referee (accuracy)
XAI_MODEL_ENGINE=grok-4.5
# Fast tier: narration / agent state / identity / battlefield / policy drafting
XAI_MODEL_FAST=grok-4-fast-non-reasoning
XAI_IMAGE_MODEL=grok-imagine-image

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ENGINE=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini

VENICE_API_KEY=
VENICEAI_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=qwen-3-7-plus
VENICE_MODEL_ENGINE=qwen-3-7-plus
VENICE_MODEL_FAST=gemini-3-5-flash-lite
# Required before Venice participates in image fallback.
VENICE_IMAGE_MODEL=

# Battle defaults
BATTLE_TURN_LIMIT=20
