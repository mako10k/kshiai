# Server
PORT=3088
HOST=127.0.0.1
DATABASE_PATH=./data/kshiai.db
SESSION_SECRET=change-me-in-production
# Comma-separated origins (local + public tunnel)
CORS_ORIGIN=http://127.0.0.1:5188,http://localhost:5188,https://kshiai.mk10.org
# true when serving over HTTPS (Cloudflare Tunnel)
COOKIE_SECURE=true

# LLM provider: mock | xai | venice
# Prefer: secdat unlock && npm run sync:secdat
# secdat keys: XAI_API_KEY, VENICEAI_API_KEY
LLM_PROVIDER=mock
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

VENICE_API_KEY=
VENICEAI_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=

# Battle defaults
BATTLE_TURN_LIMIT=20
