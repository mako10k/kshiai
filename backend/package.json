{
  "name": "@kshiai/backend",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "eval:battle-pipeline-baseline": "tsx src/scripts/evaluate-battle-pipeline-baseline.ts",
    "eval:battle-pipeline-patch": "tsx src/scripts/evaluate-battle-canonical-patch-poc.ts",
    "eval:battle-pipeline-issues": "tsx src/scripts/evaluate-battle-consistency-issue-poc.ts",
    "eval:battle-pipeline-read": "tsx src/scripts/evaluate-battle-read-coherence-poc.ts",
    "eval:battle-pipeline-projection": "tsx src/scripts/evaluate-battle-projection-poc.ts",
    "eval:battle-pipeline-graph": "tsx src/scripts/evaluate-battle-canonical-graph-poc.ts",
    "eval:battle-pipeline-adaptive": "tsx src/scripts/evaluate-battle-adaptive-adjudication-poc.ts",
    "eval:battle-pipeline-world": "tsx src/scripts/evaluate-battle-world-process-poc.ts",
    "eval:battle-pipeline-shadow-transcripts": "tsx src/scripts/capture-battle-integrated-shadow-transcripts.ts",
    "eval:battle-pipeline-shadow-receipt": "tsx src/scripts/evaluate-battle-integrated-shadow-turn.ts",
    "build:battle-pipeline-plan-basis-replay": "tsx src/scripts/build-battle-plan-basis-corrective-replay.ts",
    "eval:perception-prompts": "tsx src/scripts/evaluate-perception-prompts.ts",
    "battle-state": "tsx src/scripts/battle-semantic-state.ts",
    "migrate:character-identities": "tsx src/scripts/backfill-character-identities.ts",
    "migrate:postgres": "tsx src/scripts/postgres-migrations.ts",
    "migrate:sqlite-to-postgres": "tsx src/scripts/sqlite-to-postgres.ts",
    "smoke:postgres-runtime": "tsx src/scripts/postgres-runtime-smoke.ts",
    "smoke:supabase-auth": "tsx src/scripts/supabase-auth-smoke.ts",
    "migrate:legacy-account": "tsx src/scripts/migrate-legacy-account.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@hono/node-server": "^1.14.4",
    "@kshiai/shared": "*",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.12.34",
    "jose": "^6.2.7",
    "openai": "^5.8.2",
    "pg": "^8.22.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.1",
    "@types/pg": "^8.20.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
