{
  "name": "kshiai",
  "private": true,
  "version": "0.1.0",
  "description": "Turn-based multi-user LLM battle game",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=@kshiai/shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run typecheck",
    "sync:secdat": "bash scripts/sync-env-from-secdat.sh"
  },

  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
